-- Script (server): put in ServerScriptService
-- Applies the SRBG animation pack via HumanoidDescription (works with catalog bundle animations).

local Players = game:GetService("Players")

local PACK = {
	IdleAnimation  = 80284382285775,
	WalkAnimation  = 115610443689372,
	RunAnimation   = 132771288298297,
	JumpAnimation  = 128724226100004,
	FallAnimation  = 99424564872375,
	ClimbAnimation = 73300108309416,
	SwimAnimation  = 93136005712341,
}

local function apply(character)
	local humanoid = character:WaitForChild("Humanoid")
	local desc = humanoid:WaitForChild("HumanoidDescription", 5) or humanoid:GetAppliedDescription()
	desc = desc:Clone()
	for prop, id in pairs(PACK) do
		desc[prop] = id
	end
	humanoid:ApplyDescription(desc)
end

Players.PlayerAdded:Connect(function(player)
	player.CharacterAppearanceLoaded:Connect(apply)
end)
