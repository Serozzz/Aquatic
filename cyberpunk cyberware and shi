local function isLocked()
	return (current ~= nil) or (psycho ~= nil)
end

local function setPanelOpen(on)
	panel.Visible = on
	if on then
		panelScale.Scale = 0.92
		TweenService:Create(
			panelScale,
			TweenInfo.new(0.18, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
			{ Scale = 1 }
		):Play()
	end
end

local function flashPoints()
	pointsNum.TextColor3 = COLORS[2]
	TweenService:Create(pointsNum, TweenInfo.new(0.5), { TextColor3 = COLORS[1] }):Play()
end

local function tryUpgrade(key)
	if isLocked() then return end
	local lv = levels[key]
	if lv >= MAX_LEVEL then return end
	local cost = CONFIG.UPGRADE_COSTS[lv + 1]
	if freePoints() < cost then
		flashPoints()
		return
	end
	levels[key] = lv + 1
	if key == "humanity" then
		-- the new capacity comes in filled
		meter = math.min(getMeterMax(), meter + CONFIG.HUMANITY_PER_LEVEL)
	end
	if skeleton then skeleton.flash = 1 end
	refreshAll()
end

local function tryDegrade(key)
	if isLocked() then return end
	local lv = levels[key]
	if lv <= 0 then return end
	levels[key] = lv - 1
	if key == "humanity" then
		meter = math.min(meter, getMeterMax())
	end
	refreshAll()
end

local function equipImplant(i)
	if i == implantIndex then return end
	if isLocked() then return end
	implantIndex = i
	if skeleton then skeleton.flash = 1 end
	refreshAll()
end

-- install / remove the Fortified Ankles implant
local function toggleAnkles()
	if isLocked() then return end
	if ankleInstalled then
		ankleInstalled = false
		if cancelWall then cancelWall() end
	else
		if freePoints() < CONFIG.ANKLE_INSTALL_COST then
			flashPoints()
			return
		end
		ankleInstalled = true
		if skeleton then skeleton.flash = 1 end
	end
	refreshAll()
end

