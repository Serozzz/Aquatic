-- SKELETON IMPLANT
-- A spine rig on your back. Idle: dark metal with a faint glow in your implant color.
-- Active: ribs unfold from the bottom up and a light wave runs up the vertebrae.
-- Cyberpsychosis: everything strobes and the ribs spasm.
----------------------------------------------------------------
local skeleton = nil

local function destroySkeleton()
	if skeleton and skeleton.folder then
		skeleton.folder:Destroy()
	end
	skeleton = nil
end

-- ribs fold down along the spine (ol = 0) and swing out/back like wings (ol = 1)
local function poseRib(r, ol)
	local yaw = -r.side * ol * 1.0
	local roll = r.side * (-1.25 + ol * 1.45)
	r.weld.C0 = CFrame.new(r.side * r.px, r.y, r.z)
		* CFrame.Angles(0, yaw, roll)
		* CFrame.new(r.side * r.L / 2, 0, 0)
end

local function buildSkeleton(char)
	destroySkeleton()

	-- R15 loads in pieces, so wait briefly for the torso
	local torso = getTorso(char)
	local t0 = os.clock()
	while not torso and os.clock() - t0 < 5 and char.Parent do
		task.wait(0.1)
		torso = getTorso(char)
	end
	if not torso or not char.Parent or player.Character ~= char then return end

	local imp = getImplant()
	local dim = imp.color:Lerp(Color3.new(0, 0, 0), 0.78)
	local METAL = Color3.fromRGB(26, 28, 36)

	local folder = Instance.new("Folder")
	folder.Name = "SandevistanSkeleton"

	local H = torso.Size.Y
	local backZ = torso.Size.Z / 2
	local count = CONFIG.SKELETON_VERTEBRAE
	local y0, y1 = -H / 2 + 0.25, H / 2 - 0.2

	local sk = { folder = folder, verts = {}, ribs = {}, open = 0, wasOpen = false, flash = 0 }

	local function newPart(name, size, color, material)
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size
		p.Color = color
		p.Material = material
		p.Anchored = false
		p.CanCollide = false
		p.CanTouch = false
		p.CanQuery = false
		p.Massless = true
		p.CastShadow = false
		p:SetAttribute("NoGhost", true) -- keeps it out of afterimages/duplicates
		p.Parent = folder
		return p
	end

	local function weld(part, c0)
		local w = Instance.new("Weld")
		w.Part0 = torso
		w.Part1 = part
		w.C0 = c0
		w.Parent = part
		return w
	end

	-- glowing core line running down the spine
	local core = newPart("Core", Vector3.new(0.12, (y1 - y0) + 0.25, 0.08), dim, Enum.Material.Neon)
	weld(core, CFrame.new(0, (y0 + y1) / 2, backZ + 0.34))
	sk.core = core

	local light = Instance.new("PointLight")
	light.Range = 10
	light.Brightness = 0
	light.Shadows = false
	light.Color = imp.color
	light.Parent = core
	sk.light = light

	-- vertebrae (wide at the bottom, narrow at the top) + glow bands + ribs
	for i = 1, count do
		local a = (i - 1) / math.max(1, count - 1) -- 0 = bottom, 1 = top
		local y = y0 + (y1 - y0) * a
		local w = 0.78 - 0.34 * a

		local v = newPart("Vertebra" .. i, Vector3.new(w, 0.3, 0.28), METAL, Enum.Material.Metal)
		weld(v, CFrame.new(0, y, backZ + 0.17))

		local band = newPart("Band" .. i, Vector3.new(w * 0.7, 0.07, 0.34), dim, Enum.Material.Neon)
		weld(band, CFrame.new(0, y, backZ + 0.17))
		table.insert(sk.verts, { band = band, a = a })

		local L = 0.5 + 0.6 * math.sin(a * math.pi) -- ribs are longest mid-spine
		for _, side in ipairs({ 1, -1 }) do
			local rib = newPart("Rib", Vector3.new(L, 0.09, 0.09), dim, Enum.Material.Neon)
			local r = {
				part = rib,
				weld = weld(rib, CFrame.new()),
				side = side,
				px = w / 2 - 0.04,
				y = y,
				z = backZ + 0.17,
				L = L,
				a = a,
			}
			poseRib(r, 0)
			table.insert(sk.ribs, r)
		end
	end

	folder.Parent = char
	skeleton = sk
end

local function updateSkeleton(now, dt)
	local sk = skeleton
	if not sk or not sk.folder.Parent then return end

	local imp = getImplant()
	local activeLike = (current ~= nil) or (psycho ~= nil)
	local target = activeLike and 1 or 0
	sk.open += (target - sk.open) * math.min(1, dt * (activeLike and 6 or 3))
	local open = sk.open
	sk.flash = math.max(0, sk.flash - dt * 1.4)

	local dim = imp.color:Lerp(Color3.new(0, 0, 0), 0.78)
	local palette = current and current.palette or nil

	local function glowAt(a)
		if psycho then
			return (math.random() < 0.5) and randomNeon() or dim
		elseif palette then
			return sampleGradient(palette.stops, (math.sin(now * 2 + a * 4) + 1) / 2)
		end
		return imp.color
	end

	-- vertebra glow bands: a wave of light travels up the spine
	for _, v in ipairs(sk.verts) do
		local wave = (math.sin(now * 6 - v.a * 7) + 1) / 2
		local strength = open * (0.4 + 0.6 * wave)
		local idle = (0.22 + 0.12 * math.sin(now * 1.6 - v.a * 3)) * (1 - open)
		local k = math.max(strength, idle, sk.flash * wave)
		v.band.Color = dim:Lerp(glowAt(v.a), k)
	end

	-- ribs unfold from the bottom up
	local moving = open > 0.002 or sk.wasOpen
	sk.wasOpen = open > 0.002
	if moving then
		for _, r in ipairs(sk.ribs) do
			local ol = math.clamp(open * 1.5 - r.a * 0.5, 0, 1)
			if open > 0.3 then
				ol = math.clamp(ol + math.sin(now * 9 + r.a * 6 + r.side) * 0.05, 0, 1)
			end
			if psycho then
				ol = math.clamp(ol + (math.random() - 0.5) * 0.5, 0, 1)
			end
			poseRib(r, ol)
			r.part.Color = dim:Lerp(glowAt(r.a), ol * 0.9)
		end
	end

	-- core line + light
	local coreK = math.max(open, 0.2 + 0.1 * math.sin(now * 2), sk.flash)
	local coreColor = glowAt(0.5)
	sk.core.Color = dim:Lerp(coreColor, coreK)
	sk.light.Color = coreColor
	sk.light.Brightness = open * (1.2 + 0.6 * math.max(0, math.sin(now * 11)))
end

