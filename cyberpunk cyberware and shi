-- GHOST PARTS (shared by afterimages, cyberpsychosis duplicates and burst clones)
----------------------------------------------------------------
local function makeGhostPart(part, color, alpha)
	local ghost = part:Clone()
	if not ghost then return nil end
	for _, c in ipairs(ghost:GetChildren()) do
		if c:IsA("SpecialMesh") then
			c.TextureId = ""
		else
			c:Destroy()
		end
	end
	if ghost:IsA("MeshPart") then
		pcall(function() ghost.TextureID = "" end)
	end
	ghost.Name = "Ghost"
	ghost.Anchored = true
	ghost.CanCollide = false
	ghost.CanTouch = false
	ghost.CanQuery = false
	ghost.Massless = true
	ghost.Material = CONFIG.GHOST_MATERIAL
	ghost.Color = color
	ghost.Transparency = alpha
	return ghost
end

local function isBodyPart(part)
	return part:IsA("BasePart")
		and part.Name ~= "HumanoidRootPart"
		and part.Transparency < 0.95
		and not part:GetAttribute("NoGhost")
end

----------------------------------------------------------------
-- AFTERIMAGES (frozen in place, color shifts along the palette as they age)
----------------------------------------------------------------
local function spawnGhost(char, palette)
	if ghostCount >= CONFIG.GHOST_MAX_PARTS then return end

	local parts = {}
	local startColor = palette.stops[1].c

	for _, part in ipairs(char:GetDescendants()) do
		if isBodyPart(part) then
			local ghost = makeGhostPart(part, startColor, CONFIG.GHOST_ALPHA)
			if ghost then
				ghost.CFrame = part.CFrame
				ghost.Parent = ghostFolder
				table.insert(parts, ghost)
			end
		end
	end

	ghostCount += #parts
	table.insert(ghostBatches, { t0 = os.clock(), parts = parts, stops = palette.stops })
end

-- one shared updater drives every ghost's color/fade
RunService.RenderStepped:Connect(function()
	if #ghostBatches == 0 then return end
	local now = os.clock()
	local i = 1
	while i <= #ghostBatches do
		local b = ghostBatches[i]
		local age = (now - b.t0) / CONFIG.GHOST_LIFETIME
		if age >= 1 then
			for _, p in ipairs(b.parts) do p:Destroy() end
			ghostCount -= #b.parts
			table.remove(ghostBatches, i)
		else
			-- eased age: colors move through the gradient a little slower, so blue arrives later
			local c = sampleGradient(b.stops, age ^ CONFIG.GHOST_COLOR_EASE)
			local tr = CONFIG.GHOST_ALPHA + math.max(0, (age - 0.75) / 0.25) * (1 - CONFIG.GHOST_ALPHA)
			for _, p in ipairs(b.parts) do
				p.Color = c
				p.Transparency = tr
			end
			i += 1
		end
	end
end)

