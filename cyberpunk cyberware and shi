	task.spawn(function()
		local t = os.clock()
		while os.clock() - t < dur do
			local k = 1 - (os.clock() - t) / dur
			if humanoid.Parent then
				humanoid.CameraOffset = Vector3.new((math.random() - 0.5) * amp * k, (math.random() - 0.5) * amp * k, 0)
