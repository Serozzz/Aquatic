local function sampleGradient(stops, t)
	t = math.clamp(t, 0, 1)
	for i = 2, #stops do
		if t <= stops[i].t then
			local a, b = stops[i - 1], stops[i]
			return a.c:Lerp(b.c, (t - a.t) / (b.t - a.t))
		end
	end
	return stops[#stops].c
end

local function toColorSequence(stops)
	local keys = {}
	for _, s in ipairs(stops) do
		table.insert(keys, ColorSequenceKeypoint.new(s.t, s.c))
	end
	return ColorSequence.new(keys)
end

local GLITCH_CHARS = { "#", "%", "@", "&", "$", "?", "!", "/", "|", "0", "1", "X" }
local function corrupt(text, chance)
	local out = {}
	for i = 1, #text do
		local ch = text:sub(i, i)
		if ch ~= " " and math.random() < chance then
			ch = GLITCH_CHARS[math.random(#GLITCH_CHARS)]
		end
		out[i] = ch
	end
	return table.concat(out)
end

