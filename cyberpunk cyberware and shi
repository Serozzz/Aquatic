refreshAll = function()
	local locked = isLocked()
	lastLocked = locked
	local free = freePoints()
	local shown = math.max(0, free)

	pointsNum.Text = tostring(shown)
	implantBadge.Text = "+" .. shown
	implantBadge.Visible = shown > 0

	local cur = getImplant()
	implantSub.Text = cur.name
	implantSub.TextColor3 = cur.color

	-- tabs
	for id, tb in pairs(tabButtons) do
		local on = (id == activeTab)
		tb.button.BackgroundColor3 = on and Color3.fromRGB(18, 52, 70) or Color3.fromRGB(16, 18, 30)
		tb.button.TextColor3 = on and Color3.new(1, 1, 1) or Color3.fromRGB(130, 140, 165)
		tb.stroke.Transparency = on and 0 or 0.7
	end
	for id, list in pairs(lists) do
		list.Visible = (id == activeTab)
	end
	panelSub.Text = PANEL_SUBS[activeTab] or ""

	-- footer
	if locked then
		footer.Text = "LOCKED: Sandevistan is active. Turn it off to equip or upgrade."
		footer.TextColor3 = COLORS[2]
	else
		footer.TextColor3 = Color3.fromRGB(150, 160, 185)
		if activeTab == "implants" then
			footer.Text = (IS_TOUCH and "Tap" or "Click")
				.. " a card to equip it. LASTS = how long a full Humanity meter holds (red = cyberpsychosis before it ends)."
		elseif activeTab == "burst" then
			footer.Text = string.format(
				"Earn points: +%d for every Ghost Burst that lands 2+ teleports. Degrade an upgrade to get its points back.",
				CONFIG.POINTS_PER_BURST
			)
		elseif activeTab == "ankles" then
			footer.Text = ankleInstalled
				and string.format("[%s] ground = jump. Air = pull to wall. Press it again or jump to let go.", CONFIG.ANKLE_KEY.Name)
				or "Install the implant to use it. Removing it refunds the install points."
		else
			footer.Text = string.format(
				"Earn points: +%d per Sandevistan use, +%d per Ghost Burst. Degrade an upgrade to get its points back.",
				CONFIG.POINTS_PER_USE,
				CONFIG.POINTS_PER_BURST
			)
		end
	end

	-- sandevistan cards
	for i, c in ipairs(implantCards) do
		local imp = SANDEVISTANS[i]
		local speed, jump, drain = getStats(i)
		local lasts = timeToEmpty(drain)
		local lastsColor = (lasts >= CONFIG.DURATION) and GREEN or RED

		setRow(c.speed, speed / maxSpeed, string.format("x%.2f", speed))
		setRow(c.jump, jump / maxJump, string.format("x%.2f", jump))
		setRow(c.drain, drain / DRAIN_BAR_MAX, string.format("x%.2f", drain))
		setRow(c.lasts, lasts / CONFIG.DURATION, lasts > 99 and "99s+" or string.format("%.1fs", lasts), lastsColor)
		setPips(c.pips, levels[i], imp.color)
		styleButtons(c, i, imp.color, locked, free)

		local on = (i == implantIndex)
		c.stroke.Transparency = on and 0 or 0.65
		c.card.BackgroundColor3 = on
			and imp.color:Lerp(Color3.fromRGB(10, 10, 20), 0.85)
			or Color3.fromRGB(16, 18, 30)
		if on then
			c.tag.Text = "● EQUIPPED"
