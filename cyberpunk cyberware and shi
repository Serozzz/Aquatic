-- toPsychosis = true when the meter hit zero: skips the normal "power down"
-- effects, because the cyberpsychosis episode takes over the screen.
local function stopSession(toPsychosis)
	local s = current
	if not s then return end
	current = nil

	for _, c in ipairs(s.conns) do c:Disconnect() end
	for _, o in ipairs(s.objects) do
		if o.Parent then o:Destroy() end
	end

	local hum = s.humanoid
	if hum and hum.Parent then
		-- baseSpeed always tracks the game's latest speed (crouch, sprint, etc.)
		hum.WalkSpeed = s.baseSpeed
		if hum.UseJumpPower then
			hum.JumpPower = s.baseJump
		else
			hum.JumpHeight = s.baseJump
		end
		setAnimSpeed(hum, 1)
		if not toPsychosis then
			shake(hum, 0.7, 0.5)
		end
	end

	restoreWorld()
	if toPsychosis then return end

	blur.Size = 16
	setEffects(false, s.baseFov, 0.7)
	flashTitle("OFFLINE", COLORS[2])
	cooldownTotal = getCooldown()
	cooldownEnd = os.clock() + cooldownTotal

	-- reward for using it
	if os.clock() - s.startTime >= CONFIG.POINTS_MIN_TIME then
		awardPoints(CONFIG.POINTS_PER_USE, "SANDEVISTAN")
	end
end

local TRAIL_PARTS = {
	"Head", "LeftHand", "RightHand", "LeftFoot", "RightFoot",
	"Left Arm", "Right Arm", "Left Leg", "Right Leg",
}

local function activate()
	if psycho then return end

	-- pressing again while active cancels early (saves Humanity)
	if current then
		stopSession()
		return
	end

	if os.clock() < cooldownEnd then return end

	if meter < CONFIG.METER_MIN_TO_ACTIVATE then
		flashTitle("LOW HUMANITY", COLORS[2])
		return
	end

	local char = player.Character
	local humanoid = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not (humanoid and root) or humanoid.Health <= 0 then return end

	local imp = getImplant()
	local speed, jump, drainMult = getStats(implantIndex)
	local palette = PALETTES[paletteIndex]
	paletteIndex = paletteIndex % #PALETTES + 1

	meter = math.max(0, meter - CONFIG.METER_ACTIVATION_COST * drainMult)

	local s = {
		char = char,
		humanoid = humanoid,
		root = root,
		palette = palette,
		imp = imp,
		speed = speed,
		jump = jump,
		drainMult = drainMult,
		conns = {},
		objects = {},
		startTime = os.clock(),
		endTime = os.clock() + CONFIG.DURATION,
		baseSpeed = humanoid.WalkSpeed,
		baseJump = humanoid.UseJumpPower and humanoid.JumpPower or humanoid.JumpHeight,
		baseFov = camera.FieldOfView,
		airStart = nil,
		warned = false,
		lastSpeed = 0,
	}
	current = s

	-- speed / jump (from the equipped implant)
	humanoid.WalkSpeed = s.baseSpeed * speed
	s.lastSpeed = humanoid.WalkSpeed -- remember what we set, so we can spot outside changes
	if humanoid.UseJumpPower then
		humanoid.JumpPower = s.baseJump * jump
	else
		humanoid.JumpHeight = s.baseJump * jump
	end

	-- low gravity: upward force on YOUR character only (the world is untouched)
	local gAttach = Instance.new("Attachment")
	gAttach.Name = "SandevistanGravAttach"
	gAttach.Parent = root
	local antiGrav = Instance.new("VectorForce")
	antiGrav.Name = "SandevistanAntiGravity"
	antiGrav.Attachment0 = gAttach
	antiGrav.RelativeTo = Enum.ActuatorRelativeTo.World
	antiGrav.ApplyAtCenterOfMass = true
	antiGrav.Force = Vector3.zero
	antiGrav.Parent = root
	table.insert(s.objects, gAttach)
	table.insert(s.objects, antiGrav)

	-- body glow
	local highlight = Instance.new("Highlight")
	highlight.Adornee = char
	highlight.FillColor = palette.stops[1].c
	highlight.FillTransparency = 0.65
	highlight.OutlineColor = palette.stops[#palette.stops].c
	highlight.OutlineTransparency = 0
	highlight.DepthMode = Enum.HighlightDepthMode.Occluded
	highlight.Parent = char
	table.insert(s.objects, highlight)

	-- limb trails (same gradient as the afterimages)
	for _, name in ipairs(TRAIL_PARTS) do
		local p = char:FindFirstChild(name)
		if p and p:IsA("BasePart") then
			local a0 = Instance.new("Attachment")
			a0.Position = Vector3.new(0, 0.35, 0)
			a0.Parent = p
			local a1 = Instance.new("Attachment")
			a1.Position = Vector3.new(0, -0.35, 0)
			a1.Parent = p

			local trail = Instance.new("Trail")
			trail.Attachment0 = a0
			trail.Attachment1 = a1
			trail.Lifetime = 0.45
			trail.MinLength = 0.05
			trail.LightEmission = 1
			trail.FaceCamera = true
			trail.Color = toColorSequence(palette.stops)
			trail.Transparency = NumberSequence.new(0.2, 1)
			trail.WidthScale = NumberSequence.new(1, 0)
			trail.Parent = p

			table.insert(s.objects, a0)
			table.insert(s.objects, a1)
			table.insert(s.objects, trail)
		end
	end

	-- activation burst
	local function feetPos()
		return feetPosOf(humanoid, root)
	end
	shockwave(feetPos(), palette, 1)
	spawnGhost(char, palette)
	shake(humanoid, 1.2, 0.5)
	flashTitle("SANDEVISTAN", palette.stops[1].c)
	setEffects(true, s.baseFov, 0.4)

	-- landing impact (only after real air time)
	table.insert(s.conns, humanoid.StateChanged:Connect(function(_, new)
		if new == Enum.HumanoidStateType.Jumping or new == Enum.HumanoidStateType.Freefall then
			s.airStart = s.airStart or os.clock()
		elseif new == Enum.HumanoidStateType.Landed then
			if s.airStart and os.clock() - s.airStart > 0.6 then
				shockwave(feetPos(), palette, 0.5)
				shake(humanoid, 0.5, 0.25)
			end
			s.airStart = nil
		end
	end))

	-- main loop
	local lastPos = root.Position
	local nextScan = 0
	table.insert(s.conns, RunService.RenderStepped:Connect(function(dt)
		local now = os.clock()

		if now >= s.endTime or humanoid.Health <= 0 or not char.Parent or not root.Parent then
			stopSession()
			return
		end

		-- HUMANITY drain: gets faster the longer you stay in
		local drain = (CONFIG.METER_DRAIN_BASE + CONFIG.METER_DRAIN_RAMP * (now - s.startTime)) * s.drainMult
		meter = math.max(0, meter - drain * dt)

		if meter <= 0 then
			local baseFov = s.baseFov
			stopSession(true)
			startPsychosis(baseFov)
			return
		end

		if meter <= getMeterMax() * CONFIG.METER_WARNING_FRAC and not s.warned then
			s.warned = true
			flashTitle("HUMANITY CRITICAL", COLORS[2])
		end

		-- keep the boost in sync with the game's speed changes (crouch, sprint, etc.)
		if math.abs(humanoid.WalkSpeed - s.lastSpeed) > 0.01 then
			-- something else changed WalkSpeed, so treat that as the new base speed
			s.baseSpeed = humanoid.WalkSpeed
		end
		humanoid.WalkSpeed = s.baseSpeed * s.speed
		s.lastSpeed = humanoid.WalkSpeed

		setAnimSpeed(humanoid, CONFIG.ANIM_SPEED)

		-- cancel part of gravity on the character
		antiGrav.Force = Vector3.new(0, root.AssemblyMass * workspace.Gravity * (1 - s.imp.gravity), 0)

		local a = (math.sin(now * CONFIG.COLOR_CYCLE_SPEED) + 1) / 2
		highlight.FillColor = sampleGradient(palette.stops, a)
		highlight.OutlineColor = sampleGradient(palette.stops, 1 - a)

		if (root.Position - lastPos).Magnitude >= CONFIG.GHOST_SPACING then
			spawnGhost(char, palette)
			lastPos = root.Position
		end

		if now >= nextScan then
			scanWorld()
			nextScan = now + 0.5
		end
	end))
end

----------------------------------------------------------------
-- HUD UPDATE (buttons + humanity meter + skeleton)
----------------------------------------------------------------
RunService.RenderStepped:Connect(function(dt)
	local now = os.clock()

	updateSkeleton(now, dt)

	-- implants button looks locked while Sandevistan is on
	local locked = (current ~= nil) or (psycho ~= nil)
	implantStroke.Transparency = locked and 0.7 or 0
	implantSub.TextTransparency = locked and 0.5 or 0
	updateImplantFooter(locked)
	implantStroke.Color = getImplant().color

	-- meter regen only while fully off
	if not current and not psycho then
		meter = math.min(getMeterMax(), meter + getRegen() * dt)
	end

	-- meter visuals
	meterShown += (meter - meterShown) * math.min(1, dt * 10)
	local pct = math.clamp(meterShown / getMeterMax(), 0, 1)
	local mc = sampleGradient(METER_STOPS, pct)
	meterFill.Size = UDim2.fromScale(1, pct)
	meterFill.BackgroundColor3 = mc
	meterValue.Text = string.format("%d / %d", math.floor(meterShown + 0.5), getMeterMax())
	meterValue.TextColor3 = mc
	meterTitle.TextColor3 = mc

	if psycho then
		local flick = math.random() < 0.5
		meterStroke.Color = flick and COLORS[2] or Color3.new(1, 1, 1)
		meterStroke.Thickness = 3
		meterValue.Text = corrupt("ERR", 0.4)
		meterTitle.Text = corrupt("HUMANITY", 0.35)
		meterRoot.Position = UDim2.new(0, 22 + math.random(-4, 4), 0.5, math.random(-3, 3))
	else
		meterTitle.Text = "HUMANITY"
		meterRoot.Position = UDim2.new(0, 22, 0.5, 0)
		if meter <= getMeterMax() * CONFIG.METER_WARNING_FRAC then
			local pulse = (math.sin(now * 14) + 1) / 2
			meterStroke.Color = mc:Lerp(Color3.new(1, 1, 1), pulse)
			meterStroke.Thickness = 2 + pulse * 2
		else
			meterStroke.Color = mc
			meterStroke.Thickness = 2
		end
	end

	-- Sandevistan button
	if psycho then
		fill.Size = UDim2.fromScale(1, 1)
		fill.BackgroundColor3 = (math.random() < 0.5) and COLORS[2] or Color3.fromRGB(60, 10, 25)
		stroke.Color = randomNeon()
		stroke.Thickness = 3
		label.Text = corrupt("ERR", 0.5)
	elseif current then
		local remaining = math.max(0, current.endTime - now)
		local a = (math.sin(now * CONFIG.COLOR_CYCLE_SPEED) + 1) / 2
		fill.Size = UDim2.fromScale(1, remaining / CONFIG.DURATION)
		fill.BackgroundColor3 = sampleGradient(current.palette.stops, a)
		stroke.Color = sampleGradient(current.palette.stops, 1 - a)
		stroke.Thickness = 3
		label.Text = string.format("%.1f", remaining)
	elseif now < cooldownEnd then
		local remaining = cooldownEnd - now
		local total = cooldownTotal
		fill.Size = UDim2.fromScale(1, math.clamp(1 - remaining / total, 0, 1))
		fill.BackgroundColor3 = Color3.fromRGB(90, 90, 115)
		stroke.Color = Color3.fromRGB(90, 90, 115)
		stroke.Thickness = 3
		label.Text = tostring(math.ceil(remaining))
	else
		fill.Size = UDim2.fromScale(1, 1)
		fill.BackgroundColor3 = getImplant().color
		stroke.Color = getImplant().color
		stroke.Thickness = 3 + math.sin(now * 6)
		label.Text = "⚡"
	end

	-- Ghost Burst button
	if burst then
		local a = (math.sin(now * CONFIG.COLOR_CYCLE_SPEED) + 1) / 2
		local c = sampleGradient(PALETTES[1].stops, a)
		burstFill.Size = UDim2.fromScale(1, 1)
		burstFill.BackgroundColor3 = c
		burstStroke.Color = c
		burstLabel.Text = ">>"
	elseif psycho then
		burstFill.Size = UDim2.fromScale(1, 1)
		burstFill.BackgroundColor3 = Color3.fromRGB(60, 10, 25)
		burstStroke.Color = COLORS[2]
		burstLabel.Text = "X"
	elseif now < burstCooldownEnd then
		local remaining = burstCooldownEnd - now
		burstFill.Size = UDim2.fromScale(1, math.clamp(1 - remaining / burstCooldownTotal, 0, 1))
		burstFill.BackgroundColor3 = Color3.fromRGB(90, 90, 115)
		burstStroke.Color = Color3.fromRGB(90, 90, 115)
		burstLabel.Text = tostring(math.ceil(remaining))
	else
		burstFill.Size = UDim2.fromScale(1, 1)
		burstFill.BackgroundColor3 = getImplant().color
		burstStroke.Color = getImplant().color
		burstLabel.Text = IS_TOUCH and ">>" or "E"
	end

	-- Fortified Ankles button
	local idleText = IS_TOUCH and "^^" or "F"
	if not ankleInstalled then
		ankleFill.Size = UDim2.fromScale(1, 1)
		ankleFill.BackgroundColor3 = Color3.fromRGB(40, 42, 58)
		ankleStroke.Color = Color3.fromRGB(70, 74, 96)
		ankleLabel.Text = idleText
	elseif psycho then
		ankleFill.Size = UDim2.fromScale(1, 1)
		ankleFill.BackgroundColor3 = Color3.fromRGB(60, 10, 25)
		ankleStroke.Color = COLORS[2]
		ankleLabel.Text = "X"
	elseif wall then
		if wall.phase == "pull" then
			ankleFill.Size = UDim2.fromScale(1, 1)
			ankleFill.BackgroundColor3 = Color3.new(1, 1, 1)
			ankleStroke.Color = ANKLE_COLOR
			ankleLabel.Text = ">>"
		else
			local remaining = math.max(0, wall.endTime - now)
			local a = (math.sin(now * CONFIG.COLOR_CYCLE_SPEED) + 1) / 2
			ankleFill.Size = UDim2.fromScale(1, math.clamp(remaining / wall.total, 0, 1))
			ankleFill.BackgroundColor3 = ANKLE_COLOR:Lerp(Color3.new(1, 1, 1), a * 0.4)
			ankleStroke.Color = ANKLE_COLOR
			ankleLabel.Text = string.format("%.1f", remaining)
		end
	else
		local ch = player.Character
		local hum = ch and ch:FindFirstChildOfClass("Humanoid")
		local grounded = hum ~= nil and hum.FloorMaterial ~= Enum.Material.Air
		local endT, total
		if grounded then
			endT, total = ankleJumpEnd, CONFIG.ANKLE_JUMP_COOLDOWN
		else
			endT, total = ankleCooldownEnd, ankleCooldownTotal
		end
		if now < endT then
			local remaining = endT - now
			ankleFill.Size = UDim2.fromScale(1, math.clamp(1 - remaining / math.max(0.1, total), 0, 1))
			ankleFill.BackgroundColor3 = Color3.fromRGB(90, 90, 115)
			ankleStroke.Color = Color3.fromRGB(90, 90, 115)
			ankleLabel.Text = tostring(math.ceil(remaining))
		else
			ankleFill.Size = UDim2.fromScale(1, 1)
			ankleFill.BackgroundColor3 = ANKLE_COLOR
			ankleStroke.Color = ANKLE_COLOR
			ankleLabel.Text = idleText
		end
	end
end)

----------------------------------------------------------------
-- INPUT
----------------------------------------------------------------
button.Activated:Connect(activate)
burstButton.Activated:Connect(startBurst)
ankleButton.Activated:Connect(activateAnkles)

UIS.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end
	if input.KeyCode == Enum.KeyCode.Q or input.KeyCode == Enum.KeyCode.ButtonY then
		activate()
	elseif input.KeyCode == CONFIG.BURST_KEY or input.KeyCode == Enum.KeyCode.ButtonX then
		startBurst()
	elseif input.KeyCode == CONFIG.ANKLE_KEY or input.KeyCode == Enum.KeyCode.ButtonB then
		activateAnkles()
	elseif input.KeyCode == CONFIG.IMPLANT_KEY then
		setPanelOpen(not panel.Visible)
	end
end)

-- jumping while wall walking pushes you off the wall
UIS.JumpRequest:Connect(function()
	local w = wall
	if w then
		local v = w.normal * CONFIG.ANKLE_WALL_JUMP_OUT + Vector3.new(0, CONFIG.ANKLE_WALL_JUMP_UP, 0)
		endWall(w, "jump", v)
	end
end)

player.CharacterAdded:Connect(function(char)
	stopSession()
	cancelBurst(true)
	cancelWall()
	stopPsychosis(true) -- also re-enables controls
	meter = getMeterMax()
	cooldownEnd = 0
	burstCooldownEnd = 0
	ankleCooldownEnd = 0
	ankleJumpEnd = 0
	autoGripReady = true
	task.spawn(buildSkeleton, char)
end)

if player.Character then
	task.spawn(buildSkeleton, player.Character)
end
