----------------------------------------------------------------
-- CYBERPSYCHOSIS
-- Frozen in place, 3 glitching duplicates (right / left / behind),
-- violent camera shake, screen glitches, then a reboot.
----------------------------------------------------------------
local function stopPsychosis(silent)
	local p = psycho
	if not p then return end
	psycho = nil

	pcall(function() RunService:UnbindFromRenderStep("SandevistanPsychosis") end)

	for _, o in ipairs(p.objects) do
		if o.Parent then o:Destroy() end
	end

	local hum = p.humanoid
	if hum and hum.Parent then
		hum.WalkSpeed = p.baseSpeed
		if hum.UseJumpPower then
			hum.JumpPower = p.baseJump
		else
			hum.JumpHeight = p.baseJump
		end
		hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
		hum.AutoRotate = p.autoRotate
		hum.CameraOffset = Vector3.zero
		setAnimSpeed(hum, 1)
	end
	setControlsEnabled(true)

	hidePsychUI()
	setEffects(false, p.baseFov, 0.8)

	if not silent then
		meter = getMeterMax() * CONFIG.PSYCHOSIS_RECOVER_FRAC
		cooldownTotal = CONFIG.PSYCHOSIS_LOCKOUT
		cooldownEnd = os.clock() + cooldownTotal
		flashTitle("REBOOTED", COLORS[1])
	end
end

local function psychosisStep(dt)
	local p = psycho
	if not p then return end

	local now = os.clock()
	local elapsed = now - p.startTime
	local remaining = p.endTime - now
	local root = p.root

	if remaining <= 0 or p.humanoid.Health <= 0 or not p.char.Parent or not root.Parent then
		stopPsychosis()
		return
	end

	-- 0..1 ramp in and out so the episode doesn't pop on/off
	local k = math.min(math.clamp(elapsed / 0.35, 0, 1), math.clamp(remaining / 0.8, 0, 1))
	local heart = math.max(0, math.sin(now * 11)) ^ 6 -- sharp heartbeat thumps

	-- keep the body locked down
	p.humanoid.WalkSpeed = 0
	p.humanoid:Move(Vector3.zero)
	setAnimSpeed(p.humanoid, 0.25)

	-- ---------- camera shake (rotation + position + FOV pulse) ----------
	local nx = math.noise(now * 13, 0.3)
	local ny = math.noise(now * 13, 7.1)
	local nr = math.noise(now * 9, 3.7)
	p.spike = p.spike * math.exp(-dt * 12)
	camera.CFrame = camera.CFrame
		* CFrame.new(nx * 1.6 * k, ny * 1.6 * k, 0)
		* CFrame.Angles(ny * 0.08 * k, nx * 0.08 * k, nr * 0.4 * k + p.spike * k)
	camera.FieldOfView = p.baseFov + (-8 + heart * 7 + p.spike * 30) * k

	-- ---------- glitch tick (random, ~8-12 times a second) ----------
	if now >= p.nextGlitch then
		p.nextGlitch = now + 0.06 + math.random() * 0.1
		p.spike = (math.random() - 0.5) * 0.5

		local neon = randomNeon()
		cc.TintColor = neon:Lerp(Color3.new(1, 1, 1), 0.35)
		cc.Saturation = (math.random() < 0.2) and (math.random() < 0.5 and -1 or 1) or 0.3
		cc.Contrast = 0.3 + math.random() * 0.5
		cc.Brightness = (math.random() - 0.5) * 0.2
		blur.Size = 4 + math.random() * 14
		bloom.Intensity = 1.2 + math.random() * 1.2
		bloom.Threshold = 0.8

		glitchBars()
		redFlash.BackgroundTransparency = (math.random() < 0.35) and (0.82 + math.random() * 0.1) or 1

		psychTitle.Text = corrupt("CYBERPSYCHOSIS", 0.22)
		psychTitle.TextColor3 = neon
		psychTitle.Position = UDim2.new(0.5, math.random(-14, 14), 0.24, math.random(-8, 8))

		p.highlight.FillColor = neon
		p.highlight.OutlineColor = randomNeon()

		-- duplicates: new flicker + positional jitter
		for _, d in ipairs(p.doubles) do
			d.alpha = 0.25 + math.random() * 0.4
			if math.random() < 0.45 then
				d.jitter = Vector3.new((math.random() - 0.5) * 2.4, (math.random() - 0.5) * 1.6, (math.random() - 0.5) * 2.4)
			else
				d.jitter = Vector3.zero
			end
		end

		-- little involuntary body twitch
		if math.random() < 0.35 then
			root.CFrame = root.CFrame * CFrame.Angles(0, math.rad(math.random(-14, 14)), 0)
		end

		-- ripples of energy
		if now >= p.nextWave then
			p.nextWave = now + 1.1
			shockwave(feetPosOf(p.humanoid, root), PSYCHO_PALETTE, 1.2)
		end
	end

	-- ---------- 3 duplicates, each in its own direction ----------
	local rootCF = root.CFrame
	for i, d in ipairs(p.doubles) do
		local dir = DOUBLE_DIRS[i](rootCF)
		local wob = math.sin(now * 3 + d.phase)
		local dist = (CONFIG.DOUBLE_DISTANCE + wob * CONFIG.DOUBLE_WOBBLE) * k
		local offset = dir * dist + d.jitter * k
		local tr = 1 - (1 - d.alpha) * k
		for _, pair in ipairs(d.parts) do
			if pair.orig.Parent then
				pair.ghost.CFrame = pair.orig.CFrame + offset
				pair.ghost.Transparency = tr
			end
		end
	end

	-- ---------- screen edges throb with the heartbeat ----------
	for _, f in ipairs(edges) do
		f.BackgroundTransparency = 1 - (0.5 + heart * 0.5) * k
	end

	psychSub.Text = string.format("SYSTEM REBOOT  %.1f", remaining)
end

local function startPsychosis(baseFov)
	if psycho then return end

	local char = player.Character
	local humanoid = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not (humanoid and root) or humanoid.Health <= 0 then
		meter = getMeterMax() * CONFIG.PSYCHOSIS_RECOVER_FRAC
		cooldownTotal = CONFIG.PSYCHOSIS_LOCKOUT
		cooldownEnd = os.clock() + cooldownTotal
		return
	end

	-- a Ghost Burst or wall walk in progress gets cut off
	if cancelBurst then cancelBurst(false) end
	if cancelWall then cancelWall() end

	local now = os.clock()
	local p = {
		char = char,
		humanoid = humanoid,
		root = root,
		startTime = now,
		endTime = now + CONFIG.PSYCHOSIS_DURATION,
		baseSpeed = humanoid.WalkSpeed,
		baseJump = humanoid.UseJumpPower and humanoid.JumpPower or humanoid.JumpHeight,
		autoRotate = humanoid.AutoRotate,
		baseFov = baseFov or camera.FieldOfView,
		objects = {},
		doubles = {},
		spike = 0.4,
		nextGlitch = 0,
		nextWave = 0,
	}
	psycho = p

	-- can't move, can't jump
	setControlsEnabled(false)
	humanoid.WalkSpeed = 0
	if humanoid.UseJumpPower then
		humanoid.JumpPower = 0
	else
		humanoid.JumpHeight = 0
	end
	humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, false)
	humanoid.AutoRotate = false
	root.AssemblyLinearVelocity = Vector3.new(0, root.AssemblyLinearVelocity.Y, 0)

	-- glitching body glow
	local highlight = Instance.new("Highlight")
	highlight.Adornee = char
	highlight.FillColor = DOUBLE_COLORS[1]
	highlight.FillTransparency = 0.45
	highlight.OutlineColor = DOUBLE_COLORS[2]
	highlight.OutlineTransparency = 0
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.Parent = char
	p.highlight = highlight
	table.insert(p.objects, highlight)

	-- build the 3 duplicates (right, left, behind)
	for i = 1, #DOUBLE_DIRS do
		local d = {
			parts = {},
			phase = i * 2.1,
			alpha = 0.4,
			jitter = Vector3.zero,
		}
		for _, part in ipairs(char:GetDescendants()) do
			if isBodyPart(part) then
				local ghost = makeGhostPart(part, DOUBLE_COLORS[i], 1)
				if ghost then
					ghost.CFrame = part.CFrame
					ghost.Parent = ghostFolder
					table.insert(d.parts, { orig = part, ghost = ghost })
					table.insert(p.objects, ghost)
				end
			end
		end
		table.insert(p.doubles, d)
	end

	-- opening burst
	shockwave(feetPosOf(humanoid, root), PSYCHO_PALETTE, 1.6)
	psychTitle.TextTransparency = 0
	psychStroke.Transparency = 0
	psychSub.TextTransparency = 0
	psychSubStroke.Transparency = 0
	flashTitle("HUMANITY LOST", DOUBLE_COLORS[1])

	RunService:BindToRenderStep("SandevistanPsychosis", Enum.RenderPriority.Camera.Value + 1, psychosisStep)
end

----------------------------------------------------------------
-- GHOST BURST
-- 1. Plants a (nearly straight) line of ghost clones in front of you (where the camera looks).
-- 2. Teleports you to each clone, one after the other. The hop interval is
--    BURST_BASE_INTERVAL / (your equipped Sandevistan's speed x the HOP SPEED upgrade).
--
-- WALL CHECK (done when planting AND again right before every teleport):
--   * a body-sized block is swept from spot to spot, so walls / ceilings / pillars stop the chain
--   * a downward ray finds the floor under every clone: no floor (void / big drop), water or
--     steep slopes = the chain ends there
--   * the final spot must have no solid parts overlapping the body
----------------------------------------------------------------
local BURST_STEP_CLEAR = 1.0 -- the sweep block floats this far above the floor (so small bumps don't block it)

local function makeBurstContext(char, humanoid, root)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { char, ghostFolder }
	params.RespectCanCollide = true

	local overlap = OverlapParams.new()
	overlap.FilterType = Enum.RaycastFilterType.Exclude
	overlap.FilterDescendantsInstances = { char, ghostFolder }
	overlap.RespectCanCollide = true

	-- How high the root sits above the floor. Measured while you're standing, estimated from the
	-- body's bounding box otherwise. (The old HipHeight formula is wrong for R6 rigs and some custom
	-- characters, which put every clone inside the floor and caused "NO SPACE" every time.)
	local boxCF, boxSize = char:GetBoundingBox()
	local footOffset
	if humanoid.FloorMaterial ~= Enum.Material.Air then
		local down = workspace:Raycast(root.Position, Vector3.new(0, -12, 0), params)
		if down then
			footOffset = root.Position.Y - down.Position.Y
		end
	end
	if not footOffset then
		footOffset = root.Position.Y - (boxCF.Position.Y - boxSize.Y / 2)
	end
	footOffset = math.clamp(footOffset, 1.5, 6)

	-- body-sized sweep block: starts BURST_STEP_CLEAR above the floor, ends just under the head
	local height = math.clamp(boxSize.Y - 1.1, 2.5, 6)
	return {
		char = char,
		params = params,
		overlap = overlap,
		footOffset = footOffset,
		size = Vector3.new(2.2, height, 2.2),
		lift = Vector3.new(0, BURST_STEP_CLEAR + height / 2 - footOffset, 0), -- root -> block center
	}
end

-- floor under a point: returns the root position that stands on it, or nil (void, cliff, water, steep slope)
local function burstGround(p, refY, ctx)
	local origin = Vector3.new(p.X, refY + CONFIG.BURST_STEP_UP, p.Z)
	local length = CONFIG.BURST_STEP_UP + ctx.footOffset + CONFIG.BURST_MAX_DROP
	local r = workspace:Raycast(origin, Vector3.new(0, -length, 0), ctx.params)
	if not r then return nil, "no floor below the spot (void or too big a drop)" end
	if r.Material == Enum.Material.Water then return nil, "water" end
	if r.Normal.Y < 0.6 then return nil, "slope too steep (" .. r.Instance.Name .. ")" end
	return Vector3.new(p.X, r.Position.Y + ctx.footOffset, p.Z)
end

-- sweeps a body-sized block from `from` to `to`. Returns true if clear, otherwise false + the hit result
local function burstPathClear(from, to, ctx)
	local delta = to - from
	if delta.Magnitude < 0.05 then return true end
	local hit = workspace:Blockcast(CFrame.new(from + ctx.lift), ctx.size, delta, ctx.params)
	return hit == nil, hit
end

-- true if nothing solid overlaps a body standing at `pos` (second value = the part in the way)
local function burstSpotFree(pos, ctx)
	local box = ctx.size - Vector3.new(0.3, 0.3, 0.3)
	local parts = workspace:GetPartBoundsInBox(CFrame.new(pos + ctx.lift), box, ctx.overlap)
	return #parts == 0, parts[1]
end

-- finds a valid spot near `wanted` (shortened if a wall is in the way). Returns the spot, or nil + a reason
local function burstResolve(prev, wanted, ctx)
	local pos, why = burstGround(wanted, prev.Y, ctx)
	if not pos then return nil, why end
	local delta = pos - prev
	if delta.Magnitude < CONFIG.BURST_MIN_STEP then return nil, "spot too close to the last one" end

	local clear, hit = burstPathClear(prev, pos, ctx)
	if not clear then
		-- stop just short of the wall and try again from there
		local safe = hit.Distance - 0.4
		if safe < CONFIG.BURST_MIN_STEP then
			return nil, "wall too close: " .. hit.Instance:GetFullName()
		end
		local reduced = prev + delta.Unit * safe
		pos, why = burstGround(reduced, prev.Y, ctx)
		if not pos then return nil, why end
		if (pos - prev).Magnitude < CONFIG.BURST_MIN_STEP then return nil, "spot too close to the last one" end
		local clear2, hit2 = burstPathClear(prev, pos, ctx)
		if not clear2 then return nil, "blocked by " .. hit2.Instance:GetFullName() end
	end

	local free, blocker = burstSpotFree(pos, ctx)
	if not free then return nil, "spot occupied by " .. blocker:GetFullName() end
	return pos
end

-- returns the list of clone spots (and, if the list is empty, the reason why)
local function planBurst(ctx, root)
	local look = camera.CFrame.LookVector
	local dir = Vector3.new(look.X, 0, look.Z)
	if dir.Magnitude < 0.05 then
		local rl = root.CFrame.LookVector
		dir = Vector3.new(rl.X, 0, rl.Z)
	end
	if dir.Magnitude < 0.05 then return {}, "no usable look direction" end
	dir = dir.Unit
	local right = dir:Cross(Vector3.yAxis)

	local origin = root.Position
	local plan = {}
	local prev = origin
	local lastReason = "unknown"
	for i = 1, getBurstClones() do
		local side = (i % 2 == 1) and 1 or -1
		local wanted = origin + dir * (CONFIG.BURST_SPACING * i) + right * (side * CONFIG.BURST_ZIGZAG)
		local pos, why = burstResolve(prev, wanted, ctx)
		if not pos then
			lastReason = why or lastReason
			break
		end
		table.insert(plan, pos)
		prev = pos
	end
	return plan, lastReason
end

-- a standing copy of your current pose at `pos`
local function makeBurstClone(char, root, pos, face, palette, delay)
	local rootCF = root.CFrame
	local targetCF = CFrame.lookAt(pos, pos + face)
	local parts = {}
	for _, part in ipairs(char:GetDescendants()) do
		if isBodyPart(part) then
			local ghost = makeGhostPart(part, palette.stops[1].c, 1)
			if ghost then
				ghost.CFrame = targetCF * rootCF:ToObjectSpace(part.CFrame)
				ghost.Parent = ghostFolder
				table.insert(parts, ghost)
				TweenService:Create(
					ghost,
					TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, 0, false, delay),
					{ Transparency = 0.35 }
				):Play()
			end
		end
	end
	return { parts = parts, pos = pos, face = face, gone = false }
end

local function fadeParts(parts, t)
	for _, part in ipairs(parts) do
		if part.Parent then
			TweenService:Create(part, TweenInfo.new(t), { Transparency = 1 }):Play()
			Debris:AddItem(part, t + 0.05)
		end
	end
end

-- neon streak between two teleport points
local function burstStreak(from, to, palette)
	local dist = (to - from).Magnitude
	if dist < 0.1 then return end
	local streak = Instance.new("Part")
	streak.Anchored = true
	streak.CanCollide = false
	streak.CanTouch = false
	streak.CanQuery = false
	streak.CastShadow = false
	streak.Material = Enum.Material.Neon
	streak.Color = palette.stops[2].c
	streak.Transparency = 0.2
	streak.Size = Vector3.new(0.9, 0.9, dist)
	streak.CFrame = CFrame.lookAt(from:Lerp(to, 0.5), to)
	streak.Parent = ghostFolder
	TweenService:Create(
		streak,
		TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ Transparency = 1, Size = Vector3.new(0.05, 0.05, dist) }
	):Play()
	Debris:AddItem(streak, 0.35)
end

-- stops a burst immediately (death, respawn, cyberpsychosis)
cancelBurst = function(enableControls)
	local b = burst
	if not b then return end
	burst = nil
	b.cancelled = true
	if b.conn then b.conn:Disconnect() end
	for _, c in ipairs(b.clones) do
		for _, part in ipairs(c.parts) do
			if part.Parent then part:Destroy() end
		end
	end
	if enableControls and not psycho then
		setControlsEnabled(true)
	end
end

-- normal end of a burst
local function finishBurst(b, teleports)
	if burst ~= b then return end
	burst = nil
	if b.conn then b.conn:Disconnect() end
	for _, c in ipairs(b.clones) do
		if not c.gone then fadeParts(c.parts, 0.2) end
	end
	if not psycho then
		setControlsEnabled(true)
	end
	burstCooldownTotal = getBurstCooldown()
	burstCooldownEnd = os.clock() + burstCooldownTotal
	if teleports >= 2 then
		awardPoints(CONFIG.POINTS_PER_BURST, "GHOST BURST")
	end
end

local function runBurst(b)
	local char, humanoid, root = b.char, b.humanoid, b.root
	local function alive()
		return burst == b and not b.cancelled and humanoid.Parent ~= nil and humanoid.Health > 0 and root.Parent ~= nil
	end

	task.wait(CONFIG.BURST_PLANT_TIME)

	local teleports = 0
	for _, clone in ipairs(b.clones) do
		if not alive() then return end

		local from = root.Position
		local target = clone.pos

		-- wall check again right before jumping (things may have moved since planting)
		local ok = (from - target).Magnitude <= CONFIG.BURST_SPACING * 3
		if ok then
			ok = burstPathClear(from, target, b.ctx) and burstSpotFree(target, b.ctx)
		end
		if not ok then break end

		-- afterimage where you were, streak to where you're going
		spawnGhost(char, b.palette)
		burstStreak(from, target, b.palette)

		local flat = Vector3.new(target.X - from.X, 0, target.Z - from.Z)
		local face = (flat.Magnitude > 0.1) and flat.Unit or clone.face
		root.CFrame = CFrame.lookAt(target, target + face)
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero

		shockwave(feetPosOf(humanoid, root), b.palette, 0.4)
		shake(humanoid, 0.45, 0.15)

		-- this clone is "used up"
		clone.gone = true
		fadeParts(clone.parts, 0.15)

		teleports += 1
		task.wait(b.interval)
	end

	if not alive() then return end
	finishBurst(b, teleports)
end

local function startBurst()
	if psycho or burst or wall then return end
	if os.clock() < burstCooldownEnd then return end

	local char = player.Character
	local humanoid = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not (humanoid and root) or humanoid.Health <= 0 then return end

	-- hop speed comes from your equipped Sandevistan (upgrades included) and the HOP SPEED upgrade
	local speed, _, drainMult = getStats(implantIndex)
	local cost = CONFIG.BURST_COST * drainMult
	if meter <= cost + 1 then
		flashTitle("LOW HUMANITY", COLORS[2])
		return
	end

	local ctx = makeBurstContext(char, humanoid, root)
	local plan, reason = planBurst(ctx, root)
	if #plan == 0 then
		warn("[Ghost Burst] NO SPACE: " .. tostring(reason))
		flashTitle("NO SPACE", COLORS[2])
		return
	end

	meter = math.max(1, meter - cost)

	local palette = PALETTES[1]
	local b = {
		char = char,
		humanoid = humanoid,
		root = root,
		ctx = ctx,
		palette = palette,
		interval = math.max(0.04, CONFIG.BURST_BASE_INTERVAL / (speed * getBurstSpeedMult())),
		clones = {},
		cancelled = false,
	}
	burst = b

	setControlsEnabled(false)

	-- plant the clones, each one facing the way you'll travel
	local prev = root.Position
	for i, pos in ipairs(plan) do
		local flat = Vector3.new(pos.X - prev.X, 0, pos.Z - prev.Z)
		local face = (flat.Magnitude > 0.1) and flat.Unit or root.CFrame.LookVector
		table.insert(b.clones, makeBurstClone(char, root, pos, face, palette, (i - 1) * 0.06))
		prev = pos
	end

	shockwave(feetPosOf(humanoid, root), palette, 0.6)
	flashTitle("GHOST BURST", palette.stops[1].c)

	-- planted clones shimmer through the ghost gradient
	b.conn = RunService.RenderStepped:Connect(function()
		local now = os.clock()
		for idx, c in ipairs(b.clones) do
			if not c.gone then
				local col = sampleGradient(palette.stops, (math.sin(now * 4 + idx * 1.3) + 1) / 2)
				for _, part in ipairs(c.parts) do
					if part.Parent then part.Color = col end
				end
			end
		end
	end)

	task.spawn(runBurst, b)
end

----------------------------------------------------------------
-- FORTIFIED ANKLES
--   Ground:  press the button = a big launch jump (no Sandevistan needed, it is just a jump).
--   Air:     press the button = the ankles pull you to the nearest wall and you wall walk on it.
--   Grip:    brush a wall mid-air while moving toward it = you grip it on your own for a shorter time.
--   Jump / press the button again = let go.
--
-- Wall walking is physics based: a LinearVelocity carries you along the wall and an AlignOrientation
-- puts your feet on it. Each frame a ray is cast into the wall to follow its shape (corners, curves).
-- It ends when the time runs out, you jump off, you walk onto the floor, or you run off the edge
-- (running off the top of a wall vaults you up onto the ledge).
----------------------------------------------------------------
local moveControls
-- camera-relative move input (x = right, z = back), works for keyboard, thumbstick and gamepad
local function getMoveVector()
	if not moveControls then
		pcall(function()
			local ps = player:FindFirstChild("PlayerScripts")
			local module = ps and ps:FindFirstChild("PlayerModule")
			if module then
				moveControls = require(module):GetControls()
			end
		end)
	end
	if moveControls then
		local ok, mv = pcall(function() return moveControls:GetMoveVector() end)
		if ok and typeof(mv) == "Vector3" then return mv end
	end
	return Vector3.zero
end

local function makeWallParams(char)
	local ignore = { char, ghostFolder }
	for _, p in ipairs(Players:GetPlayers()) do
		if p.Character and p.Character ~= char then
			table.insert(ignore, p.Character)
		end
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = ignore
	params.RespectCanCollide = true
	return params
end

-- NPCs / other characters are not walls
local function validWall(r)
	if not r then return false end
	local m = r.Instance:FindFirstAncestorOfClass("Model")
	if m and m:FindFirstChildOfClass("Humanoid") then return false end
	return true
end

local function planeProject(v, n)
	return v - n * v:Dot(n)
end

-- orientation with your feet on the wall (up = wall normal) and your face toward the walking direction
local function wallCFrame(face, n)
	local dir = planeProject(face, n)
	if dir.Magnitude < 0.05 then dir = planeProject(Vector3.yAxis, n) end
	if dir.Magnitude < 0.05 then dir = planeProject(Vector3.xAxis, n) end
	return CFrame.lookAt(Vector3.zero, dir.Unit, n)
end

-- distance from the root to the soles of your feet
local function ankleFootOffset(char, root)
	local boxCF, boxSize = char:GetBoundingBox()
	return math.clamp(root.Position.Y - (boxCF.Position.Y - boxSize.Y / 2), 1.5, 6)
end

-- looks in every direction for the closest wall (steep surface). Returns the raycast result or nil
local WALL_DIRS = {}
for i = 0, 15 do
	local a = i / 16 * math.pi * 2
	table.insert(WALL_DIRS, Vector3.new(math.cos(a), 0, math.sin(a)))
end
for i = 0, 7 do
	local a = i / 8 * math.pi * 2
	table.insert(WALL_DIRS, Vector3.new(math.cos(a) * 0.87, 0.5, math.sin(a) * 0.87))
	table.insert(WALL_DIRS, Vector3.new(math.cos(a) * 0.87, -0.5, math.sin(a) * 0.87))
end

local function findNearestWall(root, params, range)
	local best
	for _, d in ipairs(WALL_DIRS) do
		local r = workspace:Raycast(root.Position, d.Unit * range, params)
		if r and math.abs(r.Normal.Y) < 0.55 and validWall(r) then
			if not best or r.Distance < best.Distance then
				best = r
			end
		end
	end
	return best
end

-- ends the wall walk. `vel` = the velocity you leave the wall with (optional)
local function endWall(w, reason, vel)
	if wall ~= w then return end
	wall = nil
	if w.conn then w.conn:Disconnect() end
	for _, o in ipairs(w.objects) do
		if o.Parent then o:Destroy() end
	end

	local humanoid, root = w.humanoid, w.root
	local n = w.normal

	if root.Parent then
		-- stand back up, nudged off the wall so the body doesn't end up inside it
		local pos = root.Position
		if n.Y < -0.6 then
			pos += n * 3
		else
			local h = Vector3.new(n.X, 0, n.Z)
			if h.Magnitude > 0.1 then
				pos += h.Unit * 1.6
			end
		end
		local look = Vector3.new(w.lastDir.X, 0, w.lastDir.Z)
		if look.Magnitude < 0.1 then
			local cl = camera.CFrame.LookVector
			look = Vector3.new(cl.X, 0, cl.Z)
		end
		if look.Magnitude < 0.1 then look = Vector3.zAxis end
		root.CFrame = CFrame.lookAt(pos, pos + look.Unit, Vector3.yAxis)
		root.AssemblyAngularVelocity = Vector3.zero
		root.AssemblyLinearVelocity = vel or (n * 6)
		wallPulse(pos, 0.5)
	end

	if humanoid.Parent then
		humanoid.PlatformStand = false
		humanoid.AutoRotate = w.autoRotate
		if humanoid.Health > 0 then
			humanoid:ChangeState(Enum.HumanoidStateType.Freefall)
		end
	end

	autoGripReady = false -- the automatic grip re-arms when you touch the ground
	local cd = (reason == "jump") and 0.8 or (w.manual and CONFIG.ANKLE_COOLDOWN or 2.5)
	ankleCooldownTotal = cd
	ankleCooldownEnd = os.clock() + cd
end

cancelWall = function()
	if wall then
		endWall(wall, "cancel")
	end
end

local function wallStep(w, dt)
	if wall ~= w then return end
	local humanoid, root = w.humanoid, w.root
	if humanoid.Health <= 0 or not root.Parent or not w.char.Parent then
		endWall(w, "dead")
		return
	end

	local now = os.clock()
	local lv, ao = w.lv, w.ao

	-- phase 1: the ankles drag you to the wall
	if w.phase == "pull" then
		local toTarget = w.target - root.Position
		if toTarget.Magnitude < 2.5 or now > w.deadline then
			w.phase = "walk"
			w.total = getWallTime(true)
			w.endTime = now + w.total
			wallPulse(root.Position, 0.6)
			shake(humanoid, 0.5, 0.2)
		else
			lv.VectorVelocity = toTarget.Unit * CONFIG.ANKLE_PULL_SPEED
			ao.CFrame = wallCFrame(w.lastDir, w.normal)
			return
		end
	end

	-- phase 2: walking on the wall
	if now >= w.endTime then
		endWall(w, "time")
		return
	end

	local foot = w.foot
	local n = w.normal

	-- camera-relative walking direction on the wall plane
	local cam = camera.CFrame
	local fwd = planeProject(cam.LookVector, n)
	if fwd.Magnitude < 0.35 then
		fwd = planeProject(cam.UpVector, n) -- looking straight into the wall: "forward" is up the wall
	end
	if fwd.Magnitude < 0.05 then fwd = planeProject(w.lastDir, n) end
	if fwd.Magnitude < 0.05 then fwd = planeProject(Vector3.yAxis, n) end
	if fwd.Magnitude < 0.05 then fwd = planeProject(Vector3.xAxis, n) end
	fwd = fwd.Unit
	local right = fwd:Cross(n)

	local mv = getMoveVector()
	local move = right * mv.X + fwd * (-mv.Z)
	if move.Magnitude > 1 then move = move.Unit end
	if move.Magnitude > 0.1 then
		w.lastDir = move.Unit
	end

	-- a wall ahead (inside corner): switch to it. A floor ahead: you walked down, so stand up.
	if move.Magnitude > 0.2 then
		local f = workspace:Raycast(root.Position, move.Unit * (foot + 1.5), w.params)
		if f and validWall(f) and math.abs(f.Normal:Dot(n)) < 0.85 then
			if f.Normal.Y >= 0.7 then
				endWall(w, "land", Vector3.zero)
				return
			end
			w.normal = f.Normal
			n = w.normal
		end
	end

	-- the surface under your feet
	local r = workspace:Raycast(root.Position, -n * (foot + 3.5), w.params)
	if r and validWall(r) then
		if r.Normal.Y >= 0.7 then
			endWall(w, "land", Vector3.zero) -- flat floor / ledge top
			return
		end
		w.normal = w.normal:Lerp(r.Normal, 0.6).Unit
		n = w.normal
		w.lost = 0
	else
		r = nil
		w.lost += dt
		if w.lost > 0.15 then
			-- ran off the edge: walking up a wall vaults you onto the ledge
			local v
			if w.lastDir.Y > 0.3 then
				v = -n * 14 + Vector3.new(0, 24, 0)
			else
				v = w.lastDir * 22
			end
			endWall(w, "edge", v)
			return
		end
	end

	-- keep the feet a fixed distance from the wall
	local stick
	if r then
		local desired = r.Position + n * (foot + 0.15)
		stick = n * math.clamp((desired - root.Position):Dot(n) * 12, -25, 25)
	else
		stick = -n * 6
	end

	local speed = CONFIG.ANKLE_WALL_SPEED * (current and CONFIG.ANKLE_SANDE_BOOST or 1)
	lv.VectorVelocity = move * speed + stick
	ao.CFrame = wallCFrame(w.lastDir, n)
end

-- hit = raycast result of the wall. manual = true -> pulled there first, false -> automatic grip
local function startWall(manual, hit, params)
	if wall or psycho or burst then return end

	local char = player.Character
	local humanoid = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not (humanoid and root) or humanoid.Health <= 0 then return end

	local now = os.clock()
	local n = hit.Normal
	local foot = ankleFootOffset(char, root)

	-- start facing up the wall (or along your heading on a slanted/flat one)
	local startDir = planeProject(Vector3.yAxis, n)
	if startDir.Magnitude < 0.2 then
		local cl = root.CFrame.LookVector
		startDir = planeProject(Vector3.new(cl.X, 0, cl.Z), n)
	end
	if startDir.Magnitude < 0.05 then startDir = planeProject(Vector3.xAxis, n) end

	local w = {
		char = char,
		humanoid = humanoid,
		root = root,
		params = params,
		normal = n,
		foot = foot,
		manual = manual,
		lastDir = startDir.Unit,
		lost = 0,
		autoRotate = humanoid.AutoRotate,
		objects = {},
	}
	if manual then
		w.phase = "pull"
		w.target = hit.Position + n * (foot + 0.15)
		w.deadline = now + hit.Distance / CONFIG.ANKLE_PULL_SPEED + 0.5
		w.endTime = math.huge
		w.total = getWallTime(true)
	else
		w.phase = "walk"
		w.total = getWallTime(false)
		w.endTime = now + w.total
	end
	wall = w

	-- hand the body over to the constraints
	humanoid.PlatformStand = true
	humanoid.AutoRotate = false

	local att = Instance.new("Attachment")
	att.Name = "AnkleAttach"
	att.Parent = root

	local lv = Instance.new("LinearVelocity")
	lv.Name = "AnkleVelocity"
	lv.Attachment0 = att
	lv.RelativeTo = Enum.ActuatorRelativeTo.World
	lv.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
	lv.MaxForce = 1e7
	lv.VectorVelocity = Vector3.zero
	lv.Parent = root

	local ao = Instance.new("AlignOrientation")
	ao.Name = "AnkleAlign"
	ao.Mode = Enum.OrientationAlignmentMode.OneAttachment
	ao.Attachment0 = att
	ao.RigidityEnabled = false
	ao.MaxTorque = 1e7
	ao.Responsiveness = 35
	ao.CFrame = wallCFrame(w.lastDir, n)
	ao.Parent = root

	w.lv, w.ao = lv, ao
	table.insert(w.objects, att)
	table.insert(w.objects, lv)
	table.insert(w.objects, ao)

	wallPulse(hit.Position + n * 0.5, 0.6)
	shake(humanoid, 0.6, 0.2)
	flashTitle(manual and "WALL PULL" or "WALL GRIP", ANKLE_COLOR)
	if skeleton then skeleton.flash = 1 end

	w.conn = RunService.Heartbeat:Connect(function(dt)
		wallStep(w, dt)
	end)
end

-- the button / key
local function activateAnkles()
	if psycho or burst then return end

	-- pressing again while wall walking lets go (with a little push away from the wall)
	if wall then
		local w = wall
		endWall(w, "manual", w.normal * 12)
		return
	end

	if not ankleInstalled then
		flashTitle("NO ANKLE IMPLANT", COLORS[2])
		return
	end

	local char = player.Character
	local humanoid = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not (humanoid and root) or humanoid.Health <= 0 then return end

	local now = os.clock()
	local grounded = humanoid.FloorMaterial ~= Enum.Material.Air

	if grounded then
		-- big launch jump
		if now < ankleJumpEnd then return end
		ankleJumpEnd = now + CONFIG.ANKLE_JUMP_COOLDOWN
		autoGripReady = true

		local power = getAnkleJump()
		humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
		task.spawn(function()
			-- the Jumping state sets its own velocity first, so override it one step later
			RunService.Heartbeat:Wait()
			if root.Parent and humanoid.Health > 0 and not wall then
				local v = root.AssemblyLinearVelocity
				root.AssemblyLinearVelocity = Vector3.new(v.X, power, v.Z)
			end
		end)

		shockwave(feetPosOf(humanoid, root), PALETTES[1], 0.45)
		shake(humanoid, 0.8, 0.25)
		if skeleton then skeleton.flash = 1 end
	else
		-- pull to the nearest wall
		if now < ankleCooldownEnd then return end
		local params = makeWallParams(char)
		local hit = findNearestWall(root, params, CONFIG.ANKLE_PULL_RANGE)
		if not hit then
			flashTitle("NO SURFACE", COLORS[2])
			return
		end
		startWall(true, hit, params)
	end
end

-- INCREASED GRIP: brushing a wall mid-air (moving toward it) grips it without pressing anything
local autoAirTime = 0
local autoParams, autoParamsChar
RunService.Heartbeat:Connect(function(dt)
	if not ankleInstalled or not CONFIG.ANKLE_AUTO_GRIP then return end
	if wall or psycho or burst then return end

	local char = player.Character
	local humanoid = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not (humanoid and root) or humanoid.Health <= 0 then return end

	if humanoid.FloorMaterial ~= Enum.Material.Air then
		autoGripReady = true
		autoAirTime = 0
		return
	end

	autoAirTime += dt
	if not autoGripReady or autoAirTime < 0.15 then return end
	if os.clock() < ankleCooldownEnd then return end

	local dir = humanoid.MoveDirection
	if dir.Magnitude < 0.1 then
		local v = root.AssemblyLinearVelocity
		dir = Vector3.new(v.X, 0, v.Z)
		if dir.Magnitude < 8 then return end
	end
	dir = Vector3.new(dir.X, 0, dir.Z)
	if dir.Magnitude < 0.05 then return end
	dir = dir.Unit

	if autoParamsChar ~= char then
		autoParams = makeWallParams(char)
		autoParamsChar = char
	end
	local r = workspace:Raycast(root.Position, dir * CONFIG.ANKLE_AUTO_REACH, autoParams)
	if r and math.abs(r.Normal.Y) < 0.55 and r.Normal:Dot(-dir) > 0.45 and validWall(r) then
		startWall(false, r, autoParams)
	end
end)

