-- upBlocked = true greys out only the UPGRADE button (e.g. ankle upgrades while the implant is not installed)
local function styleButtons(c, key, color, locked, free, upBlocked)
	local lv = levels[key]
	local nextCost = CONFIG.UPGRADE_COSTS[lv + 1]
	local canUp = (not locked) and (not upBlocked) and nextCost ~= nil and free >= nextCost
	local canDown = (not locked) and lv > 0

	c.up.Text = nextCost and string.format("UPGRADE (%d)", nextCost) or "MAXED"
	c.up.BackgroundColor3 = canUp and color:Lerp(Color3.fromRGB(10, 10, 20), 0.5) or DISABLED_BG
	c.up.TextColor3 = canUp and Color3.new(1, 1, 1) or DISABLED_TEXT

	c.down.Text = lv > 0 and string.format("DEGRADE (+%d)", CONFIG.UPGRADE_COSTS[lv]) or "DEGRADE"
	c.down.BackgroundColor3 = DISABLED_BG
	c.down.TextColor3 = canDown and Color3.fromRGB(255, 140, 150) or DISABLED_TEXT
end

-- one simple "NOW" upgrade card per definition (used by the System, Ghost Burst and Ankles tabs)
local function buildUpgradeCards(list, defs, firstOrder)
	local cards = {}
	for i, def in ipairs(defs) do
		local card = newCard(list, def.color, 108, firstOrder + i, false)
		newText(card, UDim2.fromOffset(22, 6), UDim2.new(1, -30, 0, 24), def.name, 20, def.color)
		newText(card, UDim2.fromOffset(22, 29), UDim2.new(1, -30, 0, 16), def.desc, 12, Color3.fromRGB(170, 178, 200))

		local c = {
			def = def,
			row = makeStatRow(card, 54, "NOW", def.color),
			pips = makePips(card, 88),
		}
		c.up, c.down = makeUpgradeButtons(card, def.key)
		cards[i] = c
	end
	return cards
end

local function refreshUpgradeCards(cards, locked, free)
	for _, c in ipairs(cards) do
		local def = c.def
		setRow(c.row, levels[def.key] / MAX_LEVEL, def.value())
		setPips(c.pips, levels[def.key], def.color)
		styleButtons(c, def.key, def.color, locked, free, def.blocked and def.blocked() or false)
	end
end

