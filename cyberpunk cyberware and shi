-- fortified ankles: launch speed grows with LEG POWER and (a little) with your Jumper Sandevistan's level
local function getAnkleJump()
	return CONFIG.ANKLE_JUMP_VELOCITY
		+ levels.ankleJump * CONFIG.ANKLE_JUMP_PER_LEVEL
		+ levels[2] * CONFIG.ANKLE_JUMPER_BONUS
end

local function getWallTime(manual)
	local base = manual and CONFIG.ANKLE_WALL_TIME or CONFIG.ANKLE_AUTO_TIME
	return base + levels.ankleGrip * CONFIG.ANKLE_GRIP_PER_LEVEL
end

-- speed multiplier, jump multiplier and Humanity drain multiplier for Sandevistan i at its current level
local function getStats(i)
	local imp = SANDEVISTANS[i]
	local lv = levels[i]
	local speed = imp.speed + imp.perLevel.speed * lv
	local jump = imp.jump + imp.perLevel.jump * lv
	local power = imp.perLevel.speed + imp.perLevel.jump * CONFIG.JUMP_DRAIN_WEIGHT
	local drain = imp.drain + CONFIG.DRAIN_PER_POWER * power * lv
	return speed, jump, drain
end

-- total points spent to reach `level` (levels 1..level)
local function costTo(level)
	local t = 0
	for l = 1, level do
		t += CONFIG.UPGRADE_COSTS[l]
	end
	return t
end

-- starting points (or the server's SandevistanPoints attribute) + points earned by playing
local function getTotalPoints()
	local attr = player:GetAttribute("SandevistanPoints")
	local base = (typeof(attr) == "number") and attr or CONFIG.UPGRADE_POINTS
	return base + earnedPoints
end

local function freePoints()
	local spent = ankleInstalled and CONFIG.ANKLE_INSTALL_COST or 0
	for _, lv in pairs(levels) do
		spent += costTo(lv)
	end
	return getTotalPoints() - spent
end

-- seconds a FULL humanity meter lasts with this drain multiplier
-- (drain per second = (base + ramp x t) x mult, so we solve the quadratic)
local function timeToEmpty(mult)
	local avail = math.max(0, getMeterMax() - CONFIG.METER_ACTIVATION_COST * mult)
	local b = CONFIG.METER_DRAIN_BASE * mult
	local a = CONFIG.METER_DRAIN_RAMP * mult / 2
	if a <= 0 then
		return avail / b
	end
	return (-b + math.sqrt(b * b + 4 * a * avail)) / (2 * a)
end

local function getTorso(char)
	return char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
end

-- Turns the default movement controls (keyboard / thumbstick / gamepad) on or off
local function setControlsEnabled(on)
	pcall(function()
		local ps = player:FindFirstChild("PlayerScripts")
		local module = ps and ps:FindFirstChild("PlayerModule")
		if not module then return end
		local controls = require(module):GetControls()
		if on then controls:Enable() else controls:Disable() end
	end)
end

