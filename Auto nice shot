local player = game.Players.LocalPlayer
local Event = game:GetService("ReplicatedStorage"):WaitForChild("Events"):WaitForChild("UseMove")
local RunService = game:GetService("RunService")

local canFire = true

local function getHRP()
    local character = player.Character
    if not character then return nil end
    return character:FindFirstChild("HumanoidRootPart")
end

local function getBall()
    return workspace:FindFirstChild("Ball")
end

player.CharacterAdded:Connect(function()
    canFire = true
end)

RunService.RenderStepped:Connect(function()
    if not getgenv().AutoNiceShotEnabled then return end

    local success, err = pcall(function()
        local hrp = getHRP()
        if not hrp then return end

        local ball = getBall()
        if not ball then return end

        local triggerDistance = math.clamp(getgenv().AutoNiceShotDistance or 60, 0, 60)
        local distance = (hrp.Position - ball.Position).Magnitude

        if distance <= triggerDistance and canFire then
            canFire = false

            Event:InvokeServer(2, {
                NiceShot = hrp.Position
            })

            task.delay(0.2, function()
                canFire = true
            end)
        end
    end)

    if not success then
        warn("Auto Nice Shot error: " .. tostring(err))
    end
end)
