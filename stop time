-- [DIO's Time Stop Script] -- (fixed: survives death/respawn)

-- Based on the main ability of DIO's Stand, The World, from Part 3 of JoJo's Bizarre Adventure.
-- Original by Tsuagon (screenshake portion adapted from a public tutorial).
-- This revision fixes the "breaks after i die" bug by rebuilding all character-bound
-- instances on respawn and forcibly resetting time-stop state when the humanoid dies.

----------------------------------------------------------------------------------------------------
-- Services / persistent stuff --
----------------------------------------------------------------------------------------------------

local Players = game:GetService("Players")
local tween = game:GetService("TweenService")
local lighting = game:GetService("Lighting")

local player = Players.LocalPlayer
local mouse = player:GetMouse()

local frozenobjectstable = {}
local seconds = 10 -- length of time stop, in seconds
local stoppedtime = false

-- Time Stop color effect: parented to Lighting, so it survives respawns. Only create it once.
local timestopeffect = Instance.new("ColorCorrectionEffect")
timestopeffect.Parent = lighting
timestopeffect.Saturation = 0
timestopeffect.Contrast = 0
timestopeffect.Enabled = true

-- Clock sound lives in workspace, not on the character, so it also survives respawns.
local clock = Instance.new("Sound")
clock.SoundId = "rbxassetid://4940109913"
clock.Volume = 4.5
clock.Looped = true
clock.Parent = workspace

----------------------------------------------------------------------------------------------------
-- Character-bound stuff (rebuilt every time you spawn) --
----------------------------------------------------------------------------------------------------

local char, head, torso, root, humanoid

local timestopsphere1, timestopsphere2, timestopsphere3
local timestopvoiceline, injuredtimestopvoiceline, tssfx
local timeresumevoiceline, injuredtimeresumevoiceline
local countervoiceline, countersfx, tsteleportsfx

local originalTransparency = {} -- [Instance] = number, captured fresh each spawn
local isInvisible = false
local goInvisible, goVisible -- forward-declared; assigned below

local function createSphere(parentPart)
	local sphere = Instance.new("Part")
	sphere.Material = Enum.Material.ForceField
	sphere.Size = Vector3.new(0, 0, 0)
	sphere.Shape = Enum.PartType.Ball
	sphere.CanCollide = false
	sphere.Massless = true
	sphere.Color = Color3.new(1, 1, 1)
	sphere.CastShadow = false
	sphere.Parent = parentPart

	local weld = Instance.new("Weld")
	weld.Part0 = sphere
	weld.Part1 = parentPart
	weld.C0 = parentPart.CFrame
	weld.C1 = parentPart.CFrame
	weld.Parent = sphere

	return sphere
end

local function createSound(id, vol, parent)
	local s = Instance.new("Sound")
	s.SoundId = id
	s.Volume = vol
	s.Parent = parent
	return s
end

-- Forcibly restores everything time-stop touches. Safe to call multiple times,
-- and safe to call even if we were never mid-timestop.
local function cleanupTimeStop()
	pcall(function()
		settings().Network.IncomingReplicationLag = 0
	end)

	for _, v in pairs(frozenobjectstable) do
		if v and v.Parent and v:IsA("BasePart") then
			v.Anchored = false
		end
	end
	frozenobjectstable = {}

	if timestopeffect then
		timestopeffect.Contrast = 0
		timestopeffect.Saturation = 0
	end

	for _, v in pairs(workspace:GetDescendants()) do
		if v:IsA("ParticleEmitter") or v:IsA("Fire") then
			v.TimeScale = 1
		elseif v:IsA("Sound") then
			v.PlaybackSpeed = 1
		end
	end

	if goVisible then
		goVisible()
	end

	stoppedtime = false
end

-- Cosmetic-only: fades your character's parts out/in. Does not touch hit detection,
-- collision, or positioning, so it's purely a visual effect layered on top of time stop.
goInvisible = function()
	if isInvisible then return end
	isInvisible = true
	for part, _ in pairs(originalTransparency) do
		if part and part.Parent then
			part.Transparency = 1
		end
	end
end

goVisible = function()
	if not isInvisible then return end
	isInvisible = false
	for part, t in pairs(originalTransparency) do
		if part and part.Parent then
			part.Transparency = t
		end
	end
end

local function onCharacterAdded(character)
	char = character
	humanoid = char:WaitForChild("Humanoid")
	head = char:WaitForChild("Head")
	torso = char:FindFirstChild("Torso") or char:WaitForChild("UpperTorso")
	root = char:WaitForChild("HumanoidRootPart")

	-- In case the previous life died mid-timestop, make sure nothing is left frozen/altered.
	cleanupTimeStop()

	originalTransparency = {}
	for _, v in pairs(char:GetDescendants()) do
		if v:IsA("BasePart") or v:IsA("Decal") then
			originalTransparency[v] = v.Transparency
		end
	end

	timestopsphere1 = createSphere(torso)
	timestopsphere2 = createSphere(torso)
	timestopsphere3 = createSphere(torso)

	timestopvoiceline = createSound("rbxassetid://7514417921", 5, head)
	injuredtimestopvoiceline = createSound("rbxassetid://6043864223", 5, head)
	tssfx = createSound("rbxassetid://5679636294", 5, head)
	timeresumevoiceline = createSound("rbxassetid://4329802996", 5, head)
	injuredtimeresumevoiceline = createSound("rbxassetid://6043853981", 5, head)
	countervoiceline = createSound("rbxassetid://6675048510", 5, head)
	countersfx = createSound("rbxassetid://4572672240", 4.5, head)
	tsteleportsfx = createSound("rbxassetid://3077287610", 4.5, torso)

	-- The actual fix: whenever this life's humanoid dies, force a full reset,
	-- no matter what state time-stop was in.
	humanoid.Died:Connect(function()
		cleanupTimeStop()
	end)
end

player.CharacterAdded:Connect(onCharacterAdded)
if player.Character then
	onCharacterAdded(player.Character)
end

----------------------------------------------------------------------------------------------------
-- Main Script --
----------------------------------------------------------------------------------------------------

function timestop()
	if stoppedtime == true then return end
	if not humanoid or humanoid.Health <= 0 then return end -- guard: don't start while dead

	if humanoid.Health < 50 then
		injuredtimestopvoiceline:Play()
		wait(1)
		tssfx:Play()
	elseif humanoid.Health > 50 then
		timestopvoiceline:Play()
		wait(1.6)
	end

	pcall(function()
		settings().Network.IncomingReplicationLag = math.huge
	end)

	for _, v in pairs(workspace:GetDescendants()) do
		if v:IsA("BasePart") then
			if not v.Anchored then
				if not v:IsDescendantOf(char) then
					v.Anchored = true
					table.insert(frozenobjectstable, v)
				end
			end
		end
	end

	coroutine.resume(coroutine.create(function()
		coroutine.resume(coroutine.create(function()
			timestopeffect.Enabled = true
			tween:Create(workspace.CurrentCamera, TweenInfo.new(1.5, Enum.EasingStyle.Exponential), {FieldOfView = 250}):Play()
			coroutine.resume(coroutine.create(function()
				while stoppedtime == false do
					tween:Create(timestopeffect, TweenInfo.new(0.8, Enum.EasingStyle.Quart), {Contrast = -2}):Play()
					wait(0.3)
					tween:Create(timestopeffect, TweenInfo.new(0.5, Enum.EasingStyle.Quart), {Saturation = -1}):Play()
					wait(0.2)
					tween:Create(timestopeffect, TweenInfo.new(0.5, Enum.EasingStyle.Quart), {Saturation = -2}):Play()
					wait()
					tween:Create(timestopeffect, TweenInfo.new(0.8, Enum.EasingStyle.Quart), {Contrast = -2.4}):Play()
					wait(0.3)
					tween:Create(timestopeffect, TweenInfo.new(0.5, Enum.EasingStyle.Quart), {Saturation = 1}):Play()
					wait(0.2)
					tween:Create(timestopeffect, TweenInfo.new(0.5, Enum.EasingStyle.Quart), {Saturation = -2}):Play()
				end
			end))
			wait(1.7)
			tween:Create(workspace.CurrentCamera, TweenInfo.new(1, Enum.EasingStyle.Quart), {FieldOfView = 70}):Play()
			tween:Create(timestopeffect, TweenInfo.new(1, Enum.EasingStyle.Quart), {Contrast = 0}):Play()
			tween:Create(timestopeffect, TweenInfo.new(1, Enum.EasingStyle.Quart), {Saturation = -0.8}):Play()
		end))
		coroutine.resume(coroutine.create(function()
			for _ = 1, 65 do
				wait()
				if not humanoid or not humanoid.Parent then break end -- stop shaking if we died mid-effect
				local offset1 = math.random(-650, 650) / 700
				local offset2 = math.random(-650, 650) / 700
				local offset3 = math.random(-650, 650) / 700
				tween:Create(humanoid, TweenInfo.new(0.1), {CameraOffset = Vector3.new(offset1, offset2, offset3)}):Play()
			end
			if humanoid and humanoid.Parent then
				tween:Create(humanoid, TweenInfo.new(0.1), {CameraOffset = Vector3.new(0, 0, 0)}):Play()
			end
		end))
		coroutine.resume(coroutine.create(function()
			tween:Create(timestopsphere1, TweenInfo.new(1, Enum.EasingStyle.Quart, Enum.EasingDirection.Out, 0), {Size = Vector3.new(45, 45, 45)}):Play()
			tween:Create(timestopsphere2, TweenInfo.new(1.4, Enum.EasingStyle.Quart, Enum.EasingDirection.Out, 0), {Size = Vector3.new(40, 40, 40)}):Play()
			tween:Create(timestopsphere3, TweenInfo.new(1.7, Enum.EasingStyle.Quart, Enum.EasingDirection.Out, 0), {Size = Vector3.new(35, 35, 35)}):Play()
			wait(1.7)
			tween:Create(timestopsphere1, TweenInfo.new(1, Enum.EasingStyle.Quart, Enum.EasingDirection.Out, 0), {Size = Vector3.new(0, 0, 0)}):Play()
			tween:Create(timestopsphere2, TweenInfo.new(1, Enum.EasingStyle.Quart, Enum.EasingDirection.Out, 0), {Size = Vector3.new(0, 0, 0)}):Play()
			tween:Create(timestopsphere3, TweenInfo.new(1, Enum.EasingStyle.Quart, Enum.EasingDirection.Out, 0), {Size = Vector3.new(0, 0, 0)}):Play()
		end))
		coroutine.resume(coroutine.create(function()
			for _, v in pairs(workspace:GetDescendants()) do
				if v:IsA("ParticleEmitter") then
					tween:Create(v, TweenInfo.new(3), {TimeScale = 0}):Play()
				end
			end
			for _, v in pairs(workspace:GetDescendants()) do
				if v:IsA("Fire") then
					tween:Create(v, TweenInfo.new(3), {TimeScale = 0}):Play()
				end
			end
		end))
		coroutine.resume(coroutine.create(function()
			for _, v in pairs(workspace:GetDescendants()) do
				if v:IsA("Sound") then
					if not v:IsDescendantOf(char) then
						tween:Create(v, TweenInfo.new(4), {PlaybackSpeed = 0}):Play()
					end
				end
			end
		end))
	end))

	stoppedtime = true
	goInvisible()

	-- Instead of a blind `wait(seconds)`, poll so we bail out immediately if you die mid-timestop
	-- rather than resuming several seconds later against a destroyed character.
	local elapsed = 0
	while elapsed < seconds do
		if not humanoid or humanoid.Health <= 0 then
			cleanupTimeStop()
			return
		end
		wait(0.1)
		elapsed = elapsed + 0.1
	end

	timeresume()
end

function timeresume()
	if stoppedtime == false then return end
	goVisible()
	if humanoid and humanoid.Health > 0 then
		if humanoid.Health < 50 then
			injuredtimeresumevoiceline:Play()
			wait(0.6)
		else
			timeresumevoiceline:Play()
			wait(0.9)
		end
	end

	pcall(function()
		settings().Network.IncomingReplicationLag = 0
	end)

	for _, v in pairs(frozenobjectstable) do
		if v and v.Parent and v:IsA("BasePart") then
			v.Anchored = false
		end
	end
	frozenobjectstable = {}

	coroutine.resume(coroutine.create(function()
		for _, v in pairs(workspace:GetDescendants()) do
			if v:IsA("ParticleEmitter") then
				tween:Create(v, TweenInfo.new(3), {TimeScale = 1}):Play()
			end
		end
		for _, v in pairs(workspace:GetDescendants()) do
			if v:IsA("Fire") then
				tween:Create(v, TweenInfo.new(3), {TimeScale = 1}):Play()
			end
		end
	end))
	coroutine.resume(coroutine.create(function()
		for _, v in pairs(workspace:GetDescendants()) do
			if v:IsA("Sound") then
				if not v:IsDescendantOf(char) then
					tween:Create(v, TweenInfo.new(2), {PlaybackSpeed = 1}):Play()
				end
			end
		end
	end))

	tween:Create(timestopeffect, TweenInfo.new(2, Enum.EasingStyle.Quart), {Saturation = 0}):Play()
	stoppedtime = false
end

function tsteleport()
	if stoppedtime == true then return end
	if not root or not root.Parent then return end
	tsteleportsfx:Play()
	coroutine.resume(coroutine.create(function()
		tween:Create(timestopeffect, TweenInfo.new(0.1), {TintColor = Color3.new(0, 0, 0)}):Play()
		wait(0.2)
		tween:Create(timestopeffect, TweenInfo.new(0.1), {TintColor = Color3.new(1, 1, 1)}):Play()
	end))
	root.CFrame = CFrame.new(mouse.Hit.p.X, mouse.Hit.p.Y, mouse.Hit.p.Z)
end

mouse.KeyDown:Connect(function(key)
	if key == "f" and stoppedtime == false then
		timestop()
	elseif key == "f" and stoppedtime == true then
		timeresume()
	end
	if key == "v" and stoppedtime == false then
		tsteleport()
	end
end)
