-- ===== Playback =====
local function getAnimator()
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hum then return nil end
	return hum:FindFirstChildOfClass("Animator") or hum
end

local function stopPlayback()
	for _, t in ipairs(playingTracks) do
		pcall(function()
			t:Stop(0.1)
			t:Destroy()
		end)
	end
	table.clear(playingTracks)
	activeTrack = nil
	if activeStroke then
		activeStroke.Transparency = 1
		activeStroke = nil
	end
end

-- Returns true if it started playing
local function playAnimation(animationId, cardStroke)
	stopPlayback()
	local animator = getAnimator()
	if not animator then return false end

	local anim = Instance.new("Animation")
	anim.AnimationId = animationId
	local ok, track = pcall(function()
		return animator:LoadAnimation(anim)
	end)
	if not ok or not track then return false end

	track.Priority = Enum.AnimationPriority.Action4
	track.Looped = true
	track:Play(0.1, 1, 1)
	table.insert(playingTracks, track)
	activeTrack = track
	activeStroke = cardStroke
	cardStroke.Transparency = 0
	return true
end

-- ===== Logic =====
local function setBadge()
	badge.Text = tostring(count)
	empty.Visible = count == 0
end

local function setSwitch(on)
	copyAsLink = on
	tween(switch, { BackgroundColor3 = on and C.accent or C.off })
	tween(knob, { Position = on and UDim2.new(1, -19, 0.5, -8) or UDim2.new(0, 3, 0.5, -8) })
end

switch.MouseButton1Click:Connect(function()
	setSwitch(not copyAsLink)
end)

local order = 0
local function logAnimation(name, animationId)
	local numericId = tonumber(tostring(animationId):match("%d+"))
	if not numericId or logged[numericId] then return end
	logged[numericId] = true
	count += 1
	order -= 1 -- newest on top
	setBadge()

	local card = Instance.new("TextButton")
	card.Size = UDim2.new(1, 0, 0, 58)
	card.BackgroundColor3 = C.card
	card.Text = ""
	card.AutoButtonColor = false
	card.LayoutOrder = order
	card.Parent = list
	corner(card, 10)
	local playStroke = stroke(card, C.success, 1.5, 1)

	local nameL = label(card, name, 14, C.text, FONT_BOLD)
	nameL.Size = UDim2.new(1, -90, 0, 20)
	nameL.Position = UDim2.new(0, 12, 0, 9)
	nameL.TextTruncate = Enum.TextTruncate.AtEnd

	local idL = label(card, "ID  " .. numericId .. "   ·   click to play", 12, C.subtext)
	idL.Size = UDim2.new(1, -90, 0, 18)
	idL.Position = UDim2.new(0, 12, 0, 30)
	idL.TextTruncate = Enum.TextTruncate.AtEnd

	local copyL = Instance.new("TextButton")
	copyL.Text = "COPY"
	copyL.TextSize = 11
	copyL.TextColor3 = C.accent
	copyL.Font = FONT_BOLD
	copyL.AutoButtonColor = false
	copyL.Size = UDim2.new(0, 56, 0, 26)
	copyL.Position = UDim2.new(1, -66, 0.5, -13)
	copyL.BackgroundTransparency = 0.85
	copyL.BackgroundColor3 = C.accent
	copyL.Parent = card
	corner(copyL, 8)

	card.MouseEnter:Connect(function() tween(card, { BackgroundColor3 = C.cardHover }) end)
	card.MouseLeave:Connect(function() tween(card, { BackgroundColor3 = C.card }) end)

	-- Click the card: play it on your character. Click again to stop.
	card.MouseButton1Click:Connect(function()
		if activeStroke == playStroke then
			stopPlayback()
		else
			playAnimation(animationId, playStroke)
		end
	end)

	copyL.MouseButton1Click:Connect(function()
		local value = copyAsLink and ("https://www.roblox.com/library/" .. numericId) or tostring(numericId)
		if clipboard then
			clipboard(value)
			copyL.Text = "COPIED"
			copyL.TextColor3 = C.success
		else
			print("[AnimationLogger] " .. value)
			copyL.Text = "PRINTED"
		end
		task.delay(1.2, function()
			if copyL.Parent then
				copyL.Text = "COPY"
				copyL.TextColor3 = C.accent
			end
		end)
	end)
end

