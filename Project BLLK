-- REWORK: rather than betting on one method name (ToggleHide/Hide/Show) and
-- keeping our own IsHidden boolean in sync with it by hand, we now:
--   1) try a handful of known Rayfield toggle method names when the button
--      is clicked/keybind pressed, remembering whichever one works so we
--      don't re-guess every time
--   2) separately, run a small loop that polls the REAL Rayfield:IsVisible()
--      state and syncs ToggleButton.Visible from that directly
-- This means the button's visibility can never drift out of sync with
-- reality, regardless of which internal method name your Rayfield build
-- actually exposes - it no longer depends on us guessing correctly.
local KnownToggleMethods = {"ToggleHide", "Minimise", "Minimize"}
local WorkingToggleMethod = nil

local function ToggleRayfieldUI()
   local Success, ErrorMessage = false, "No working method found yet"

   if WorkingToggleMethod then
      Success, ErrorMessage = pcall(function()
         Window[WorkingToggleMethod](Window)
      end)
   else
      for _, MethodName in ipairs(KnownToggleMethods) do
         if type(Window[MethodName]) == "function" then
            Success, ErrorMessage = pcall(function()
               Window[MethodName](Window)
            end)
            if Success then
               WorkingToggleMethod = MethodName
               break
            end
         end
      end
   end

   -- Fallback: some Rayfield builds expose SetVisibility directly on the
   -- Rayfield table itself rather than a per-Window method.
   if not Success then
      Success, ErrorMessage = pcall(function()
         Rayfield:SetVisibility(not Rayfield:IsVisible())
      end)
      if Success then
         WorkingToggleMethod = nil -- this path doesn't use Window methods
      end
   end

   if not Success then
      warn("[ToggleRayfieldUI] " .. tostring(ErrorMessage))
      Rayfield:Notify({
         Title = "Toggle Failed",
         Content = tostring(ErrorMessage),
         Duration = 8,
      })
   end
   -- NOTE: ToggleButton.Visible is intentionally NOT set here anymore -
   -- the polling loop below is now the single source of truth for it.
end

