-- Animate the gradient rotation continuously so the outline looks "alive"
task.spawn(function()
   while task.wait(0.03) do
      if not ToggleGui or not ToggleGui.Parent then break end
      StrokeGradient.Rotation = (StrokeGradient.Rotation + 2) % 360
   end
end)

-- Single source of truth for the button's visibility: poll Rayfield's real
-- IsVisible() state directly, rather than tracking our own boolean that can
-- drift out of sync depending on which toggle method actually worked.
task.spawn(function()
   while task.wait(0.1) do
      if not ToggleGui or not ToggleGui.Parent then break end
      local Success, Visible = pcall(function() return Rayfield:IsVisible() end)
      if Success then
         ToggleButton.Visible = (not Visible) and getgenv().DraggableButtonEnabled
      else
         warn("[ButtonVisibilitySync] " .. tostring(Visible))
      end
   end
end)

-- Dragging logic (works with mouse and touch)
local dragging = false
local dragInput
local dragStart
local startPos
local dragDistance = 0

local function updateDrag(input)
   local delta = input.Position - dragStart
   dragDistance = delta.Magnitude
   ToggleButton.Position = UDim2.new(
      startPos.X.Scale, startPos.X.Offset + delta.X,
      startPos.Y.Scale, startPos.Y.Offset + delta.Y
   )
end

ToggleButton.InputBegan:Connect(function(input)
   if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
      dragging = true
      dragDistance = 0
      dragStart = input.Position
      startPos = ToggleButton.Position

      input.Changed:Connect(function()
         if input.UserInputState == Enum.UserInputState.End then
            dragging = false
            getgenv().RayfieldButtonPosition = ToggleButton.Position -- save position for next time it appears
         end
      end)
   end
end)

ToggleButton.InputChanged:Connect(function(input)
   if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
      dragInput = input
   end
end)

UserInputService.InputChanged:Connect(function(input)
   if input == dragInput and dragging then
      updateDrag(input)
   end
end)

-- Clicking (not dragging) the button toggles the Rayfield UI
ToggleButton.MouseButton1Click:Connect(function()
   if dragDistance > 5 then return end -- ignore click if it was actually a drag

   ToggleRayfieldUI()
end)

-- Custom keybind that also opens/closes the UI (changeable from Settings tab)
UserInputService.InputBegan:Connect(function(input, gameProcessed)
   if gameProcessed then return end
   if input.KeyCode == getgenv().UIOpenKeybind then
      ToggleRayfieldUI()
   end
end)

