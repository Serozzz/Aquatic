local KeybindInput = SettingsTab:CreateInput({
   Name = "Change UI Open Keybind",
   PlaceholderText = "Type a key (e.g. RightAlt, K, F4)",
   RemoveTextAfterFocusLost = true,
   Callback = function(Text)
      local KeyName = Text:gsub("%s+", "") -- strip spaces
      local Success, KeyCodeOrError = pcall(function()
         return Enum.KeyCode[KeyName]
      end)

      if Success and KeyCodeOrError then
         if KeyCodeOrError == Enum.KeyCode.F15 then
            Rayfield:Notify({
               Title = "Reserved Keybind",
               Content = "F15 is reserved internally and can't be used here. Please pick a different key.",
               Duration = 5,
            })
            return
         end

         getgenv().UIOpenKeybind = KeyCodeOrError
         Rayfield:Notify({
            Title = "Keybind Updated",
            Content = "UI open keybind successfully changed to " .. KeyName,
            Duration = 4,
         })
      else
         Rayfield:Notify({
            Title = "Invalid Keybind",
            Content = "'" .. Text .. "' is not a recognized key. Try something like RightAlt, K, or F4.",
            Duration = 5,
         })
      end
   end,
})

