-- ==========================================
-- CORE INVENTORY & DRAG-AND-DROP LOGIC
-- ==========================================
local function getCharacter()
	return player.Character
end

local function isToolEquipped(tool)
	local char = getCharacter()
	return char ~= nil and tool ~= nil and tool.Parent == char
end

local function getEquippedTools()
	local equipped = {}
	local char = getCharacter()
	if char then
		for _, child in ipairs(char:GetChildren()) do
			if child:IsA("Tool") then
				table.insert(equipped, child)
			end
		end
	end
	return equipped
end

local function getAllTools()
	local tools = {}
	local backpack = player:FindFirstChild("Backpack")
	local char = getCharacter()
	if backpack then
		for _, item in ipairs(backpack:GetChildren()) do
			if item:IsA("Tool") then
				table.insert(tools, item)
			end
		end
	end
	if char then
		for _, item in ipairs(char:GetChildren()) do
			if item:IsA("Tool") then
				table.insert(tools, item)
			end
		end
	end
	return tools
end

local function isToolInHotbar(tool)
	for i = 1, CONFIG.MaxSlots do
		if HotbarSlots[i] == tool then
			return i
		end
	end
	return nil
end

local function syncSavedOrder()
	for i = 1, CONFIG.MaxSlots do
		if HotbarSlots[i] then
			SavedOrder[HotbarSlots[i].Name] = i
		end
	end
end

local function cancelActiveDrag()
	DragState.Active = false
	DragState.Started = false
	DragState.Tool = nil
	dragGhost.Visible = false
end

local function updateSideButtons()
	local hasDroppableEquipped = false
	for _, tool in ipairs(getEquippedTools()) do
		if tool.CanBeDropped then
			hasDroppableEquipped = true
			break
		end
	end

	dropActionBtn.LayoutOrder = 1
	multiActionBtn.LayoutOrder = 2
	dropActionBtn.Visible = CONFIG.ShowDropBtn and hasDroppableEquipped
	multiActionBtn.Visible = CONFIG.ShowMultiBtn
	multiActionBtn.Text = MultiEquipMode and "Multi: ON" or "Multi: OFF"

	local stroke = multiActionBtn:FindFirstChild("BtnStroke")
	if stroke then
		stroke.Color = MultiEquipMode and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(90, 95, 100)
	end
end

local function setStrokeIdle(stroke)
	stroke.Color = Color3.fromRGB(70, 74, 80)
	stroke.Thickness = 1
	stroke.Transparency = 0.3
end

local function setStrokeEquipped(stroke)
	stroke.Color = ACCENT
	stroke.Thickness = 1.5
	stroke.Transparency = 0
end

local function renderSlotVisual(btn, tool)
	local icon = btn:FindFirstChild("Icon")
	local toolNameLbl = btn:FindFirstChild("ToolName")
	local dropMark = btn:FindFirstChild("DroppableMark")
	local stroke = btn:FindFirstChild("SelectionStroke")
	local equipLine = btn:FindFirstChild("EquipLine")

	if tool then
		if tool.TextureId ~= "" then
			if icon then
				icon.Image = tool.TextureId
				icon.Visible = true
			end
			if toolNameLbl then toolNameLbl.Visible = false end
		else
			if icon then icon.Visible = false end
			if toolNameLbl then
				toolNameLbl.Text = tool.Name
				toolNameLbl.Visible = true
			end
		end

		if dropMark then
			dropMark.Visible = tool.CanBeDropped
		end

		if isToolEquipped(tool) then
			local useLine = CONFIG.EquipStyle == "Line"
			if stroke then
				if useLine then setStrokeIdle(stroke) else setStrokeEquipped(stroke) end
			end
			if equipLine then equipLine.Visible = useLine end
			btn.BackgroundColor3 = Color3.fromRGB(50, 53, 58)
		else
			if stroke then setStrokeIdle(stroke) end
			if equipLine then equipLine.Visible = false end
			btn.BackgroundColor3 = Color3.fromRGB(25, 27, 29)
		end
	else
		if icon then icon.Visible = false end
		if toolNameLbl then toolNameLbl.Visible = false end
		if dropMark then dropMark.Visible = false end
		if stroke then setStrokeIdle(stroke) end
		if equipLine then equipLine.Visible = false end
		btn.BackgroundColor3 = Color3.fromRGB(25, 27, 29)
	end
end

local function isPointInGui(point, guiObj)
	if not guiObj or not guiObj.Visible then return false end
	local pos = guiObj.AbsolutePosition
	local size = guiObj.AbsoluteSize
	return point.X >= pos.X and point.X <= (pos.X + size.X)
		and point.Y >= pos.Y and point.Y <= (pos.Y + size.Y)
end

local function beginPotentialDrag(input, tool, sourceType, sourceSlot)
	if not backpackWindow.Visible then return end
	if not tool then return end
	if input.UserInputType ~= Enum.UserInputType.MouseButton1
		and input.UserInputType ~= Enum.UserInputType.Touch then
		return
	end

	DragState.Active = true
	DragState.Started = false
	DragState.Tool = tool
	DragState.SourceType = sourceType
	DragState.SourceSlot = sourceSlot
	DragState.StartPos = Vector2.new(input.Position.X, input.Position.Y)
	DragState.InputObj = input
end

local function refreshUI()
	for i = 1, 9 do
		local btn = slotButtons[i]
		if i <= CONFIG.MaxSlots then
			btn.Visible = true
			renderSlotVisual(btn, HotbarSlots[i])
		else
			btn.Visible = false
		end
	end

	if backpackWindow.Visible and not settingsPanel.Visible then
		for _, child in ipairs(gridScroll:GetChildren()) do
			if child:IsA("TextButton") then
				child:Destroy()
			end
		end

		local allTools = getAllTools()
		local filtered = {}
		for _, tool in ipairs(allTools) do
			local matchesSearch = (SearchQuery == "")
				or string.find(string.lower(tool.Name), string.lower(SearchQuery), 1, true)
			local matchesFilter = true
			if CurrentFilter == "Droppable" then
				matchesFilter = tool.CanBeDropped
			elseif CurrentFilter == "Undroppable" then
				matchesFilter = not tool.CanBeDropped
			end
			if matchesSearch and matchesFilter then
				table.insert(filtered, tool)
			end
		end

		table.sort(filtered, function(a, b)
			local orderA = ToolData[a] and ToolData[a].AddedOrder or 0
			local orderB = ToolData[b] and ToolData[b].AddedOrder or 0
			if CurrentFilter == "Oldest" then
				return orderA < orderB
			else
				return orderA > orderB
			end
		end)

		for idx, tool in ipairs(filtered) do
			local itemBtn = createSlotButton("BP_" .. tool.Name, gridScroll, false)
			local slotNum = itemBtn:FindFirstChild("SlotNumber")
			if slotNum then slotNum.Text = "" end
			itemBtn.LayoutOrder = idx
			renderSlotVisual(itemBtn, tool)

			if isToolInHotbar(tool) then
				local stroke = itemBtn:FindFirstChild("SelectionStroke")
				if stroke then
					stroke.Color = Color3.fromRGB(220, 220, 220)
					stroke.Transparency = 0.35
				end
			end

			itemBtn.InputBegan:Connect(function(input)
				beginPotentialDrag(input, tool, "Backpack", nil)
			end)

			itemBtn.MouseButton1Click:Connect(function()
				if DragState.Started then return end
				local existingSlot = isToolInHotbar(tool)
				if existingSlot then
					HotbarSlots[existingSlot] = nil
					SavedOrder[tool.Name] = nil
				else
					for s = 1, CONFIG.MaxSlots do
						if not HotbarSlots[s] then
							HotbarSlots[s] = tool
							SavedOrder[tool.Name] = s
							break
						end
					end
				end
				refreshUI()
			end)
		end
	end

	updateSideButtons()
end

local function finishDrag(endPos)
	if not DragState.Active then return end

	local wasDragging = DragState.Started
	local draggedTool = DragState.Tool
	local sourceType = DragState.SourceType
	local sourceSlot = DragState.SourceSlot

	cancelActiveDrag()

	if not backpackWindow.Visible or not wasDragging or not draggedTool then
		return
	end

	-- 1. Dropped onto a hotbar slot
	local targetHotbarSlot = nil
	for i = 1, CONFIG.MaxSlots do
		if isPointInGui(endPos, slotButtons[i]) then
			targetHotbarSlot = i
			break
		end
	end

	if targetHotbarSlot then
		if sourceType == "Hotbar" and sourceSlot then
			local displacedTool = HotbarSlots[targetHotbarSlot]
			HotbarSlots[targetHotbarSlot] = draggedTool
			HotbarSlots[sourceSlot] = displacedTool
			if displacedTool then
				SavedOrder[displacedTool.Name] = sourceSlot
			end
			SavedOrder[draggedTool.Name] = targetHotbarSlot
		elseif sourceType == "Backpack" then
			local existingSlot = isToolInHotbar(draggedTool)
			local displacedTool = HotbarSlots[targetHotbarSlot]
			if existingSlot then
				HotbarSlots[existingSlot] = displacedTool
				if displacedTool then
					SavedOrder[displacedTool.Name] = existingSlot
				end
			elseif displacedTool then
				SavedOrder[displacedTool.Name] = nil
			end
			HotbarSlots[targetHotbarSlot] = draggedTool
			SavedOrder[draggedTool.Name] = targetHotbarSlot
		end
		syncSavedOrder()
		refreshUI()
		return
	end

	-- 2. Dropped onto the backpack window
	if isPointInGui(endPos, backpackWindow) then
		if sourceType == "Hotbar" and sourceSlot then
			HotbarSlots[sourceSlot] = nil
			SavedOrder[draggedTool.Name] = nil
			refreshUI()
			return
		elseif sourceType == "Backpack" then
			for _, child in ipairs(gridScroll:GetChildren()) do
				if child:IsA("TextButton") and isPointInGui(endPos, child) then
					local targetToolName = string.sub(child.Name, 4)
					for toolObj, data in pairs(ToolData) do
						if toolObj.Name == targetToolName and toolObj ~= draggedTool and ToolData[draggedTool] then
							local draggedOrder = ToolData[draggedTool].AddedOrder
							ToolData[draggedTool].AddedOrder = data.AddedOrder
							data.AddedOrder = draggedOrder
							refreshUI()
							return
						end
					end
				end
			end
		end
	end
end

UserInputService.InputChanged:Connect(function(input)
	if not DragState.Active then return end

	if not backpackWindow.Visible then
		cancelActiveDrag()
		return
	end

	if input.UserInputType ~= Enum.UserInputType.MouseMovement and input ~= DragState.InputObj then
		return
	end

	local currentPos = Vector2.new(input.Position.X, input.Position.Y)

	if not DragState.Started then
		if (currentPos - DragState.StartPos).Magnitude >= 10 then
			DragState.Started = true
			local tool = DragState.Tool
			if tool then
				if tool.TextureId ~= "" then
					ghostIcon.Image = tool.TextureId
					ghostIcon.Visible = true
					ghostLabel.Visible = false
				else
					ghostIcon.Visible = false
					ghostLabel.Text = tool.Name
					ghostLabel.Visible = true
				end
				dragGhost.Visible = true
			end
		end
	end

	if DragState.Started then
		dragGhost.Position = UDim2.fromOffset(currentPos.X, currentPos.Y)

		for i = 1, CONFIG.MaxSlots do
			local btn = slotButtons[i]
			local stroke = btn:FindFirstChild("SelectionStroke")
			if stroke then
				if isPointInGui(currentPos, btn) then
					stroke.Color = ACCENT
					stroke.Transparency = 0
				elseif not isToolEquipped(HotbarSlots[i]) then
					setStrokeIdle(stroke)
				end
			end
		end
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if not DragState.Active then return end
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input == DragState.InputObj then
		local endPos = Vector2.new(input.Position.X, input.Position.Y)
		task.defer(function()
			finishDrag(endPos)
		end)
	end
end)

local function toggleEquipTool(tool)
	if not tool then return end
	local char = getCharacter()
	local humanoid = char and char:FindFirstChildOfClass("Humanoid")
	local backpack = player:FindFirstChild("Backpack")
	if not humanoid or not backpack then return end

	if isToolEquipped(tool) then
		tool.Parent = backpack
	else
		if not MultiEquipMode then
			humanoid:UnequipTools()
		end
		tool.Parent = char
	end
	refreshUI()
end

local function dropEquippedTool()
	local char = getCharacter()
	if not char then return end

	for _, tool in ipairs(getEquippedTools()) do
		if tool.CanBeDropped then
			local slot = isToolInHotbar(tool)
			if slot then
				HotbarSlots[slot] = nil
			end
			tool.Parent = workspace
			break
		end
	end
	refreshUI()
end

local function registerTool(tool)
	if not tool:IsA("Tool") then return end

	if not ToolData[tool] then
		OrderCounter += 1
		ToolData[tool] = { AddedOrder = OrderCounter }
	end

	if isToolInHotbar(tool) then
		refreshUI()
		return
	end

	local savedSlot = SavedOrder[tool.Name]
	if savedSlot and savedSlot <= CONFIG.MaxSlots and not HotbarSlots[savedSlot] then
		HotbarSlots[savedSlot] = tool
		refreshUI()
		return
	end

	for i = 1, CONFIG.MaxSlots do
		if not HotbarSlots[i] then
			HotbarSlots[i] = tool
			SavedOrder[tool.Name] = i
			break
		end
	end
	refreshUI()
end

local function unregisterTool(tool)
	if not tool:IsA("Tool") then return end
	task.defer(function()
		local backpack = player:FindFirstChild("Backpack")
		local char = getCharacter()
		if tool.Parent ~= backpack and tool.Parent ~= char then
			for i = 1, 9 do
				if HotbarSlots[i] == tool then
					HotbarSlots[i] = nil
				end
			end
			ToolData[tool] = nil
			refreshUI()
		end
	end)
end

