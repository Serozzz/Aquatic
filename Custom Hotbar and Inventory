local function applyHotbarSize()
	local k = 1
	if CONFIG.ScaleBySlots then
		k = 1 + (9 - CONFIG.MaxSlots) * 0.06 -- 9 slots = 1x, 5 slots = ~1.24x, 1 slot = ~1.48x
	end
	local size = math.floor(58 * k + 0.5)

	for i = 1, 9 do
		slotButtons[i].Size = UDim2.new(0, size, 0, size)
	end
	backpackSlotBtn.Size = UDim2.new(0, size, 0, size)

	hotbarFrame.Size = UDim2.new(0, (CONFIG.MaxSlots + 1) * (size + 6) + 6, 0, size + 6)
	backpackWindow.Position = UDim2.new(0.5, 0, 1, -(size + 28))
end
applyHotbarSize()

