local uiScale = Instance.new("UIScale")
uiScale.Parent = root

local function computeUIScale()
	if type(CONFIG.UIScale) == "number" then
		return CONFIG.UIScale
	end
	local cam = workspace.CurrentCamera
	local vp = cam and cam.ViewportSize or Vector2.new(1920, 1080)
	return math.clamp(math.min(vp.X / 900, vp.Y / 450), 0.65, 1)
end

local function applyUIScale()
	local s = computeUIScale()
	uiScale.Scale = s
	root.Size = UDim2.new(1 / s, 0, 1 / s, 0)
end

local function hookCamera()
	local cam = workspace.CurrentCamera
	if cam then
		cam:GetPropertyChangedSignal("ViewportSize"):Connect(applyUIScale)
	end
	applyUIScale()
end
hookCamera()
workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(hookCamera)

