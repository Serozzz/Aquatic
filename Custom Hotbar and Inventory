-- Keep the default Roblox Backpack disabled (re-disables if the game turns it back on)
local function disableDefaultBackpack()
	pcall(function()
		if StarterGui:GetCoreGuiEnabled(Enum.CoreGuiType.Backpack) then
			StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
		end
	end)
end

disableDefaultBackpack()

pcall(function()
	StarterGui.CoreGuiChangedSignal:Connect(function(coreGuiType, enabled)
		if enabled and (coreGuiType == Enum.CoreGuiType.Backpack or coreGuiType == Enum.CoreGuiType.All) then
			disableDefaultBackpack()
		end
	end)
end)

task.spawn(function()
	while true do
		disableDefaultBackpack()
		task.wait(0.5)
	end
end)

