-- Keep the default Roblox Backpack disabled no matter what the game does
local RunService = game:GetService("RunService")

local function disableDefaultBackpack(force)
	pcall(function()
		if force or StarterGui:GetCoreGuiEnabled(Enum.CoreGuiType.Backpack) then
			StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
		end
	end)
end

disableDefaultBackpack(true)

local reenableCount = 0
pcall(function()
	StarterGui.CoreGuiChangedSignal:Connect(function(coreGuiType, enabled)
		if enabled and (coreGuiType == Enum.CoreGuiType.Backpack or coreGuiType == Enum.CoreGuiType.All) then
			reenableCount += 1
			if reenableCount == 1 then
				warn("[CustomHotbar] Another script re-enabled the default Roblox backpack. Hiding it again. Search your game for SetCoreGuiEnabled.")
			elseif reenableCount == 100 then
				warn("[CustomHotbar] The default backpack was re-enabled 100+ times. A loop in your game is doing this.")
			end
			disableDefaultBackpack(true)
		end
	end)
end)

-- Checked every frame (before render and after physics) so it never gets a frame on screen
local function enforceBackpackOff()
	disableDefaultBackpack(false)
	-- again after every other handler on this signal has run (beats a game script that re-enables it)
	task.defer(disableDefaultBackpack, false)
end

pcall(function()
	RunService:BindToRenderStep("HideDefaultBackpack", 2000000000, enforceBackpackOff)
end)
for _, signalName in ipairs({ "RenderStepped", "PreRender", "Heartbeat", "Stepped", "PreSimulation", "PostSimulation", "PreAnimation" }) do
	pcall(function()
		RunService[signalName]:Connect(enforceBackpackOff)
	end)
end

-- Hard re-apply a few times a second in case Get lies
task.spawn(function()
	while true do
		disableDefaultBackpack(true)
		task.wait(0.25)
	end
end)

-- After every respawn, force it off every frame for a couple of seconds
player.CharacterAdded:Connect(function()
	task.spawn(function()
		for _ = 1, 120 do
			disableDefaultBackpack(true)
			RunService.Heartbeat:Wait()
		end
	end)
end)

